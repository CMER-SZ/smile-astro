import BaseLayout from "@/layouts/BaseLayout.astro";
import { i18nPaths, useI18n } from "@/i18n/utils";
export function getStaticPaths() {
  return [...i18nPaths];
}
const { dict } = useI18n(Astro.url);
---

<BaseLayout tdkKey="home">
  <section class="bg-bg-subtle h-[120vh]">
    <div class="wrapper text-center">
      <h1
        set:html={dict.home.title}
        class="text-primary text-xl lg:text-3xl font-black"
      />
      <p set:html={dict.home.subtitle} class="text-primary" />
    </div>
  </section>
</BaseLayout>
