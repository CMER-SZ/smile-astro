<script>
  import gsap from "gsap";
  import Swiper from "swiper";
  import { Autoplay, FreeMode } from "swiper/modules";
  import "swiper/css";

  // 1. 榮譽獎項平滑跑馬燈 (平滑無縫滾動)
  function initAwardsMarqueeSwiper() {
    const el = document.getElementById("awardsMarqueeSwiper");
    if (!el) return;
    if ((el as any).swiper) {
      (el as any).swiper.destroy(true, true);
    }

    new Swiper(el, {
      modules: [Autoplay, FreeMode],
      loop: true,
      slidesPerView: "auto",
      spaceBetween: 20,
      speed: 4000,
      autoplay: {
        delay: 0,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      },
      freeMode: {
        enabled: true,
        momentum: true,
        momentumRatio: 1.2,
      },
      allowTouchMove: true,
      grabCursor: true,
    });
  }

  // 2. GSAP C-M-E-R 經營理念支柱滾動逐項交錯浮現 (Stagger Reveal) + 字母懸停微彈性反饋
  function initPillarsAnimation() {
    const timeline = document.querySelector(".cmer-timeline");
    const items = document.querySelectorAll(".cmer-timeline-item");
    if (!timeline || !items.length) return;

    if (!("IntersectionObserver" in window)) {
      gsap.set(items, { opacity: 1, y: 0 });
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              gsap.fromTo(
                items,
                { opacity: 0, y: 30 },
                {
                  opacity: 1,
                  y: 0,
                  duration: 0.65,
                  stagger: 0.12,
                  ease: "power2.out",
                  overwrite: "auto",
                }
              );
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
      );
      observer.observe(timeline);
    }

    // 字母標籤懸停微物理回彈
    items.forEach((item) => {
      const letter = item.querySelector(".cmer-timeline-letter, .cmer-vertical-badge");
      if (!letter) return;

      item.addEventListener("mouseenter", () => {
        gsap.to(letter, {
          scale: 1.15,
          color: "#2e5699",
          duration: 0.3,
          ease: "back.out(2)",
          overwrite: "auto",
        });
      });

      item.addEventListener("mouseleave", () => {
        gsap.to(letter, {
          scale: 1,
          color: "#4570b6",
          duration: 0.25,
          ease: "power2.out",
          overwrite: "auto",
        });
      });
    });
  }

  // 3. GSAP 希瑪關懷大使吉祥物呼吸微浮動 + WhatsApp 諮詢按鈕週期性微脈衝
  function initCareAmbassadorAnimations() {
    const mascot = document.querySelector(".care-ambassador-mascot-img");
    if (mascot) {
      gsap.to(mascot, {
        y: -10,
        duration: 2.4,
        repeat: -1,
        yoyo: true,
        ease: "sine.inOut",
      });
    }

    const whatsappBtn = document.querySelector(".care-ambassador-whatsapp-btn");
    const whatsappIcon = document.querySelector(".care-ambassador-whatsapp-icon");
    if (whatsappBtn && whatsappIcon) {
      // 週期性微搖擺動態，吸引視覺轉化焦點
      const pulseTimeline = gsap.timeline({ repeat: -1, repeatDelay: 3.5 });
      pulseTimeline
        .to(whatsappIcon, { rotation: -10, scale: 1.08, duration: 0.15, ease: "power1.inOut" })
        .to(whatsappIcon, { rotation: 10, scale: 1.08, duration: 0.15, ease: "power1.inOut" })
        .to(whatsappIcon, { rotation: -6, duration: 0.1, ease: "power1.inOut" })
        .to(whatsappIcon, { rotation: 0, scale: 1, duration: 0.15, ease: "power1.out" });
    }
  }

  // 4. GSAP 畫廊 3 圖 (Gallery 3 Cards) 懸停光學微浮動
  function initGalleryInteractive() {
    const figures = document.querySelectorAll<HTMLElement>(".group-gallery-figure");
    figures.forEach((figure) => {
      figure.addEventListener("mouseenter", () => {
        gsap.to(figure, {
          y: -6,
          scale: 1.02,
          duration: 0.35,
          ease: "power2.out",
          overwrite: "auto",
        });
      });

      figure.addEventListener("mouseleave", () => {
        gsap.to(figure, {
          y: 0,
          scale: 1,
          duration: 0.3,
          ease: "power2.inOut",
          overwrite: "auto",
        });
      });
    });
  }

  // 5. GSAP 兩大核心圓形徽章 (Logo 徽章 & 獎盃徽章) 滾動進場彈性顯現與懸浮呼吸
  function initFloatingBadgesAnimation() {
    const badges = document.querySelectorAll(".center-intro-badge, .awards-recognition-badge");
    if (!badges.length) return;

    if ("IntersectionObserver" in window) {
      const badgeObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target;

              gsap.fromTo(
                el,
                { scale: 0.8, opacity: 0.6, y: 30 },
                {
                  scale: 1,
                  opacity: 1,
                  y: 0,
                  duration: 0.8,
                  ease: "back.out(1.5)",
                  overwrite: "auto",
                }
              );
              badgeObserver.unobserve(el);
            }
          });
        },
        { threshold: 0.1 }
      );

      badges.forEach((b) => badgeObserver.observe(b));
    }
  }

  function initGroupProfileInteractions() {
    initAwardsMarqueeSwiper();
    initPillarsAnimation();
    initCareAmbassadorAnimations();
    initGalleryInteractive();
    initFloatingBadgesAnimation();
  }

  document.addEventListener("DOMContentLoaded", initGroupProfileInteractions);
  document.addEventListener("astro:page-load", initGroupProfileInteractions);
</script>
