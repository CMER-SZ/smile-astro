---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { useTranslations, i18nPaths } from "@/i18n/utils";
const lang = Astro.currentLocale || "zh-hk";
const t = useTranslations(lang);
export function getStaticPaths() {
  return i18nPaths;
}
---

