---
/*
 * @Author: 谭洁莹
 * @Date: 2026-04-24 18:42:52
 * @LastEditTime: 2026-06-01 09:39:51
 * @FilePath: /src/pages/[...lang]/group-profile.astro
 * @Description: 集团及中心简介
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { i18nPaths, useI18n } from "@/i18n/utils";
export function getStaticPaths() {
  return [...i18nPaths];
}
const { dict } = useI18n(Astro.url);
---

<BaseLayout tdkKey="about">
  <section
    class="text-desc lg:text-xl font-light leading-[1.75] tracking-widest lg:tracking-[0.3em]"
  >
    <div class="wrapper text-center space-y-6 lg:space-y-9">
      <div>
        <h2
          class="text-primary text-xl lg:text-3xl font-black pb-5 lg:pb-7 mb-6 lg:mb-8 relative before:absolute before:content-[''] before:h-1 before:w-8 lg:before:h-1.5 lg:before:w-10 before:bg-[#A6E1D6] before:rounded-full before:bottom-0 before:left-1/2 before:-translate-x-1/2"
        >
          {dict.about.group.intro.title}
        </h2>
        <p>{dict.about.group.intro.desc}</p>
      </div>
      <div>
        <h3 class="text-primary">{dict.about.group.eye.title}</h3>
        <p>{dict.about.group.eye.desc}</p>
        <p>
          {dict.about.group.eye.more}
          <a href="https://hkcmereye.com" target="_blank" class="text-primary"
            >www.hkcmereye.com</a
          >
        </p>
      </div>
      <div>
        <h3 class="text-primary">{dict.about.group.philosophy.title}</h3>
        <p class="mb-8 md:mb-15 lg:mb-22">{dict.about.group.philosophy.desc}</p>
      </div>
    </div>
  </section>
</BaseLayout>
