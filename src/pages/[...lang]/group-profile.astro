import BaseLayout from "@/layouts/BaseLayout.astro";
import GroupProfileEnvironment from "@/components/views/GroupProfileEnvironment.astro";
import { i18nPaths, useI18n, getLangFromUrl } from "@/i18n/utils";
import "@/styles/pages/group-profile.scss";

// 支援多語言靜態路徑導出 (zh-HK / zh-CN)
export function getStaticPaths() {
  return [...i18nPaths];
}

const { dict } = useI18n(Astro.url);
const lang = getLangFromUrl(Astro.url);
const isCn = lang === "zh-cn";

// 榮獲權威獎項與國際認證徽章 (10 項)
const awardBadges = [
  { src: "https://statichk.cmermedical.com/imgs/2024/08/2dc8e2cd2f95150f.png", alt: "香港希瑪眼科榮譽認證 1 - 權威醫療機構認證" },
  { src: "https://statichk.cmermedical.com/imgs/2024/05/9fb7b59c6d134014.png", alt: "香港希瑪眼科榮譽認證 2 - 蔡司卓越手術中心" },
  { src: "https://statichk.cmermedical.com/imgs/2024/05/86e300274d8bc4ef.png", alt: "香港希瑪眼科榮譽認證 3 - 國際眼科品質認證" },
  { src: "https://statichk.cmermedical.com/imgs/2024/05/788333406bba2c0f.png", alt: "香港希瑪眼科榮譽認證 4 - 港股上市醫療集團殊榮" },
  { src: "https://statichk.cmermedical.com/imgs/2024/05/29433265c4f65fdf.png", alt: "香港希瑪眼科榮譽認證 5 - 大健康產業創新獎" },
  { src: "https://statichk.cmermedical.com/imgs/2024/05/402f4a682ca2394a.png", alt: "香港希瑪眼科榮譽認證 6 - 卓越醫療服務大獎" },
  { src: "https://statichk.cmermedical.com/imgs/2024/05/16b586d7718ac0a6.png", alt: "香港希瑪眼科榮譽認證 7 - STAAR Surgical 認證中心" },
  { src: "https://statichk.cmermedical.com/imgs/2024/07/8fab0d4a7e7ef4ac.png", alt: "香港希瑪眼科榮譽認證 8 - 傑出眼科醫療專科成就" },
  { src: "https://statichk.cmermedical.com/imgs/2024/08/a1b0a5b199d5b9a7.png", alt: "香港希瑪眼科榮譽認證 9 - 蔡司官方合作夥伴認證" },
  { src: "https://statichk.cmermedical.com/imgs/2024/08/64ae764b38e2a2a7.png", alt: "香港希瑪眼科榮譽認證 10 - 國際屈光手術學會認證" },
];
---

<BaseLayout tdkKey="about">
  <main id="main-content" class="group-profile-page w-full overflow-hidden">
    
    {/* 1. 頂部 Hero Banner (Container 寬度約束 + 最大高度 300px) */}
    <section class="group-hero-banner py-4 md:py-8" aria-label="集團簡介導言區">
      <div class="container mx-auto px-4">
        <header class="group-hero-card">
          <div class="group-hero-card-content">
            <h1 class="group-hero-title">
              {dict.about.group.intro.title}
            </h1>
            <p class="group-hero-subtitle">Group Profile</p>
          </div>
        </header>
      </div>
    </section>

    {/* 2. 集團簡介與 C-M-E-R 經營理念板塊 (WebP 山水畫 X 軸無縫循環背景 + 內嵌 Container 卡片) */}
    <section class="group-philosophy-section w-full" aria-labelledby="section-group-heading">
      {/* 獨立的山水畫無縫滾動背景圖層 */}
      <div class="group-landscape-bg" aria-hidden="true"></div>

      <div class="container mx-auto px-4 relative z-10">
        <article class="group-philosophy-card">
          {/* 標題與引言 */}
          <header class="text-center">
            <h2 id="section-group-heading" class="section-title-pill">
              {dict.about.group.intro.title}
            </h2>
            <p class="section-lead-text">
              {dict.about.group.intro.desc}
            </p>
          </header>

          {/* 門市網絡與官方鏈接 */}
          <div class="group-network-info">
            <h3 class="group-network-title">
              {dict.about.group.eye.title}
            </h3>
            <p class="group-network-desc">
              {dict.about.group.eye.desc}
            </p>
            <div class="group-network-link-row">
              <span>{dict.about.group.eye.more}</span>
              <a
                href="https://www.hkcmereye.com"
                target="_blank"
                rel="noopener noreferrer"
                class="group-network-link"
                aria-label="瀏覽香港希瑪眼科中心官方網站 (在新視窗中開啟)"
              >
                www.hkcmereye.com
              </a>
            </div>
          </div>

          {/* 經營理念導言 */}
          <div class="group-philosophy-intro">
            <h3 class="group-philosophy-intro-title">
              {dict.about.group.philosophy.title}
            </h3>
            <p class="group-philosophy-intro-desc">
              {dict.about.group.philosophy.desc}
            </p>
          </div>

          {/* C-M-E-R 核心理念條目 (垂直指示軸) */}
          <div class="cmer-timeline" role="list">
            {/* C */}
            <article class="cmer-timeline-item" role="listitem">
              <div class="cmer-timeline-letter" aria-hidden="true">C</div>
              <div class="cmer-timeline-body">
                <h4 class="cmer-timeline-title">{dict.about.group.philosophy.c}</h4>
                <p class="cmer-timeline-subtitle">Professional Clinical Services</p>
              </div>
            </article>

            {/* M */}
            <article class="cmer-timeline-item" role="listitem">
              <div class="cmer-timeline-letter" aria-hidden="true">M</div>
              <div class="cmer-timeline-body">
                <h4 class="cmer-timeline-title">{dict.about.group.philosophy.m}</h4>
                <p class="cmer-timeline-subtitle">Modern Management</p>
              </div>
            </article>

            {/* E */}
            <article class="cmer-timeline-item" role="listitem">
              <div class="cmer-timeline-letter" aria-hidden="true">E</div>
              <div class="cmer-timeline-body">
                <h4 class="cmer-timeline-title">{dict.about.group.philosophy.e}</h4>
                <p class="cmer-timeline-subtitle">Quality Education</p>
              </div>
            </article>

            {/* R */}
            <article class="cmer-timeline-item" role="listitem">
              <div class="cmer-timeline-letter" aria-hidden="true">R</div>
              <div class="cmer-timeline-body">
                <h4 class="cmer-timeline-title">{dict.about.group.philosophy.r}</h4>
                <p class="cmer-timeline-subtitle">Pioneering Research</p>
              </div>
            </article>

            {/* 豎排「希瑪」理念寓意 */}
            <article class="cmer-timeline-item cmer-timeline-item-vertical" role="listitem">
              <div class="cmer-vertical-badge" aria-hidden="true">希瑪</div>
              <div class="cmer-timeline-body">
                <p class="cmer-timeline-quote">
                  {dict.about.group.philosophy.cmer}
                </p>
              </div>
            </article>

            {/* 榮譽殊榮清單 */}
            <aside class="group-honors" aria-label="希瑪眼科醫療技術與服務榮譽">
              <h3 class="group-honors-title">{dict.about.group.honor.title}</h3>
              <ul class="group-honors-list">
                {dict.about.group.honor.list.map((item: string) => (
                  <li class="group-honors-item">{item}</li>
                ))}
              </ul>
            </aside>
          </div>

          {/* 3 張精選環境與醫療團隊畫廊 (無損 WebP + 嚴格限制最大尺寸 344 × 194 px) */}
          <div class="group-gallery-grid">
            <figure class="group-gallery-figure">
              <img
                src="/assets/images/group-profile/gallery-01.webp"
                alt={isCn ? "香港希玛眼科医疗集团中环眼科中心现代化门市环境" : "香港希瑪眼科醫療集團中環眼科中心現代化門市環境"}
                loading="lazy"
                decoding="async"
                width="344"
                height="194"
                class="group-gallery-img"
              />
              <figcaption class="sr-only">中環眼科中心接待處與等候空間</figcaption>
            </figure>
            <figure class="group-gallery-figure">
              <img
                src="/assets/images/group-profile/gallery-02.webp"
                alt={isCn ? "香港希玛国际眼科医疗团队与眼科专科医生阵容" : "香港希瑪國際眼科醫療團隊與眼科專科醫生陣容"}
                loading="lazy"
                decoding="async"
                width="344"
                height="194"
                class="group-gallery-img"
              />
              <figcaption class="sr-only">林順潮教授領銜之眼科專科醫療團隊</figcaption>
            </figure>
            <figure class="group-gallery-figure">
              <img
                src="/assets/images/group-profile/gallery-03.webp"
                alt={isCn ? "香港希玛微笑矫视中心无菌手术室与舒适候诊大堂" : "香港希瑪微笑矯視中心無菌手術室與舒適候診大堂"}
                loading="lazy"
                decoding="async"
                width="344"
                height="194"
                class="group-gallery-img"
              />
              <figcaption class="sr-only">國際高規格全飛秒激光無菌手術室與諮詢空間</figcaption>
            </figure>
          </div>
        </article>
      </div>
    </section>

