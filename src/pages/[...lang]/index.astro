  }}
>
  %book-button {
    aspect-ratio: 1/1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 12px;
    border: 1px solid #fff;
    border-radius: 50%;
  }
  %book-before {
    content: "";
    width: 100%;
    height: 100%;
    border-radius: 50%;
    position: absolute;
    right: -4px;
    bottom: -4px;
    background-color: var(--color-primary);
    border: 1px solid #fff;
    z-index: -1;
  }
  .intro-main {
    position: relative;
    &::before,
    &::after {
      content: "";
      position: absolute;
      background-repeat: no-repeat;
      background-size: contain;
    }
    &::before {
      width: clamp(100px, 32vw, 140px);
      height: clamp(100px, 32vw, 140px);
      background-image: var(--introAiming);
      right: -48px;
      top: clamp(-40px, -7vw, -32px);
    }
    &::after {
      width: clamp(160px, 39vw, 180px);
      aspect-ratio: 25/16;
      bottom: -68px;
      left: -40px;
      background-image: var(--introLens);
      rotate: 22deg;
    }
  }
  .book {
    .book-button {
      position: absolute;
      z-index: 20;
      &:first-child {
        left: 28px;
        bottom: 48px;
        width: clamp(140px, 41vw, 160px);
      }
      &:last-child {
        right: 40px;
        bottom: -52px;
        width: clamp(144px, 43vw, 168px);
      }
    }
    .book-check {
      @extend %book-button;
      position: relative;
      width: 100%;
      height: 100%;
      transition:
        background-color 300ms ease-in-out,
        color 300ms ease-in-out;
      &::before {
        @extend %book-before;
        opacity: 0;
        transition: opacity 0.3s ease-in-out;
      }
      &:hover::before {
        opacity: 100;
      }
    }
    .book-lecture {
      @extend %book-button;
      position: relative;
      width: 100%;
      height: 100%;
      background-color: #fff;
      &::before {
        @extend %book-before;
      }
    }
  }
  .reviews {
    background-image: var(--bgM);
    background-size: cover;
    background-position: bottom;
    .reviews-main {
      position: relative;
      border: 1px solid var(--color-primary);
      width: 100%;
      height: 436px;
      padding: 48px 32px 0 32px;
      background-color: #fff;
      &::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: calc(100% + 1px);
        aspect-ratio: 13 / 1;
        background-image: url("data:image/svg+xml;base64,");
        background-repeat: no-repeat;
        background-size: cover;
      }
    }
  }
  @media screen and (min-width: 768px) {
    .reviews {
      background-position: center 80%;
      .reviews-main {
        padding-top: 72px;
        height: 520px;
      }
    }
  }
  @media screen and (min-width: 1024px) {
