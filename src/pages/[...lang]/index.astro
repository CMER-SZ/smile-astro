  import { gsap } from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    const container = document.querySelector("[data-reviews-container]");
    const wrapper = container?.querySelector(".reviews-scroll");

    if (container && wrapper) {
      // 1. 克隆列表
      const clone = wrapper.cloneNode(true);
      container.appendChild(clone);

      // 2. 创建动画
      const tl = gsap.to([wrapper, clone], {
        yPercent: -100,
        ease: "none",
        duration: 20,
        repeat: -1,
      });

      // --- 3. 事件监听（完美兼容 PC + 移动端） ---

      // PC 端：鼠标移入暂停，移出恢复
      container.addEventListener("mouseenter", () => tl.pause());
      container.addEventListener("mouseleave", () => tl.play());

      // 移动端：手指按下暂停
      container.addEventListener("touchstart", () => tl.pause(), {
        passive: true,
      });
      // 移动端：手指抬起恢复
      container.addEventListener("touchend", () => tl.play(), {
        passive: true,
      });
      // 移动端：手指滑出容器范围时也恢复（防止动画死锁）
      container.addEventListener("touchcancel", () => tl.play(), {
        passive: true,
      });
    }
  });
</script>
