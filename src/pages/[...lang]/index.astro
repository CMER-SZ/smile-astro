<!-- GSAP 評價平滑滾動控制腳本 -->
<script>
  import { gsap } from "gsap";

  function initReviewsMarquee() {
    const track = document.getElementById("reviews-track");
    const marquee = document.getElementById("reviews-marquee");
    if (!track || !marquee) return;

    const cardHeight = 110;
    const totalItems = track.children.length;
    const halfItems = totalItems / 2;
    const scrollDistance = halfItems * cardHeight;

    const tween = gsap.to(track, {
      y: -scrollDistance,
      duration: 30,
      ease: "none",
      repeat: -1,
      modifiers: {
        y: gsap.utils.unitize((y) => parseFloat(y) % scrollDistance),
      },
    });

    marquee.addEventListener("mouseenter", () => tween.pause());
    marquee.addEventListener("mouseleave", () => tween.play());
    marquee.addEventListener("touchstart", () => tween.pause(), { passive: true });
    marquee.addEventListener("touchend", () => tween.play(), { passive: true });
  }

  function initFourFeatureObserver() {
    const el = document.getElementById("fourFeature");
    if (!el) return;

    function runCounters(container: HTMLElement) {
      const counters = container.querySelectorAll<HTMLElement>(".counter-num");
      counters.forEach((counter) => {
        const target = parseFloat(counter.getAttribute("data-target") || "0");
        const obj = { val: 0 };
        gsap.to(obj, {
          val: target,
          duration: 2.2,
          ease: "power2.out",
          delay: 0.6, // 等待十字架生長與卡片浮現展開時同步跑數
          onUpdate: () => {
            counter.textContent = Math.floor(obj.val).toLocaleString();
          },
          onComplete: () => {
            counter.textContent = target.toLocaleString();
          },
        });
      });
    }

    if (!("IntersectionObserver" in window)) {
      el.classList.add("is-inview");
      runCounters(el);
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            el.classList.add("is-inview");
            runCounters(el);
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.15 }
    );
    observer.observe(el);
  }

  function initPageInteractions() {
    initReviewsMarquee();
    initFourFeatureObserver();
  }

  document.addEventListener("DOMContentLoaded", initPageInteractions);
  document.addEventListener("astro:page-load", initPageInteractions);
</script>
