import BaseLayout from "@/layouts/BaseLayout.astro";
import VideoCarousel from "@/components/common/VideoCarousel.astro";
import { i18nPaths, useI18n } from "@/i18n/utils";
export function getStaticPaths() {
  return [...i18nPaths];
}
const { dict } = useI18n(Astro.url);
---

<BaseLayout tdkKey="home">
  <section class="bg-bg-subtle">
    <div class="wrapper text-center">
      <h1 set:html={dict.home.title} class="title-normal" />
      <p set:html={dict.home.subtitle} class="text-primary" />
      <div class="text-normal" set:html={dict.home.intro} />
    </div>
  </section>
  <section>
    <h2 class="title-normal">{dict.home.service.title}</h2>
  </section>
  <VideoCarousel />
  <section>
    <h2 class="title-normal">{dict.home.reviews.title}</h2>
  </section>
  <section class="bg-primary text-white">
    <h2 class="title-normal text-white">{dict.home.book.title}</h2>
  </section>
  <section>
    <h2 class="title-normal">{dict.home.awards.title}</h2>
  </section>
</BaseLayout>
