import BaseLayout from "@/layouts/BaseLayout.astro";
import UserCases from "@/components/common/UserCases.astro";
import { i18nPaths, useI18n } from "@/i18n/utils";
export function getStaticPaths() {
  return [...i18nPaths];
}
const { dict } = useI18n(Astro.url);
---

<BaseLayout tdkKey="home">
  <section class="bg-bg-light">
    <div class="wrapper text-center">
      <h1
        set:html={dict.home.title}
        class="text-primary text-xl lg:text-3xl font-black"
      />
      <p set:html={dict.home.subtitle} class="text-primary" />
    </div>
  </section>
  <section>
    <h2>{dict.home.service.title}</h2>
  </section>
  <UserCases />
  <section>
    <h2>{dict.home.reviews.title}</h2>
  </section>
  <section class="bg-primary text-white">
    <h2>{dict.home.book.title}</h2>
  </section>
  <section>
    <h2>{dict.home.awards.title}</h2>
  </section>
</BaseLayout>
