<!-- GSAP 評價平滑滾動控制腳本 -->
<script>
  import { gsap } from "gsap";

  function initReviewsMarquee() {
    const track = document.getElementById("reviews-track");
    const marquee = document.getElementById("reviews-marquee");
    if (!track || !marquee) return;

    const cardHeight = 110;
    const totalItems = track.children.length;
    const halfItems = totalItems / 2;
    const scrollDistance = halfItems * cardHeight;

    const tween = gsap.to(track, {
      y: -scrollDistance,
      duration: 30,
      ease: "none",
      repeat: -1,
      modifiers: {
        y: gsap.utils.unitize((y) => parseFloat(y) % scrollDistance),
      },
    });

    marquee.addEventListener("mouseenter", () => tween.pause());
    marquee.addEventListener("mouseleave", () => tween.play());
    marquee.addEventListener("touchstart", () => tween.pause(), { passive: true });
    marquee.addEventListener("touchend", () => tween.play(), { passive: true });
  }

  function initFourFeatureObserver() {
    const el = document.getElementById("fourFeature");
    if (!el) return;

    function runCounters(container: HTMLElement) {
      const counters = container.querySelectorAll<HTMLElement>(".counter-num");
      counters.forEach((counter) => {
        const target = parseFloat(counter.getAttribute("data-target") || "0");
        const obj = { val: 0 };
        gsap.to(obj, {
          val: target,
          duration: 3.2,
          ease: "power2.out",
          delay: 0.8, // 與十字架生長與卡片展開同步緩慢跑數
          onUpdate: () => {
            counter.textContent = Math.floor(obj.val).toLocaleString();
          },
          onComplete: () => {
            counter.textContent = target.toLocaleString();
          },
        });
      });
    }

    if (!("IntersectionObserver" in window)) {
      el.classList.add("is-inview");
      runCounters(el);
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            el.classList.add("is-inview");
            runCounters(el);
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.25, rootMargin: "0px 0px -50px 0px" }
    );
    observer.observe(el);
  }

  // 1. GSAP 裝飾圖層滾動微視差 (Multi-plane Parallax)
  function initParallaxDeco() {
    const aiming = document.querySelector<HTMLElement>(".centerSevice-svg-top");
    const lens = document.querySelector<HTMLElement>(".centerSevice-svg-bottom");
    if (!aiming && !lens) return;

    let ticking = false;
    window.addEventListener("scroll", () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollY = window.scrollY;
          // 背景瞄準鏡與 EVO ICL 晶體進行差速輕微位移，營造光學透鏡景深感
          if (aiming) {
            aiming.style.transform = `translate3d(0, ${scrollY * 0.08}px, 0)`;
          }
          if (lens) {
            lens.style.transform = `translate3d(0, ${-scrollY * 0.05}px, 0)`;
          }
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }

  // 2. 矯視服務卡片「激光聚焦點光微跟隨」 (Laser Spotlight Cursor Follower)
  function initServiceSpotlight() {
    const cards = document.querySelectorAll<HTMLElement>(".centerSeviceNewItem");
    cards.forEach((card) => {
      card.addEventListener("mousemove", (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty("--mouse-x", `${x}px`);
        card.style.setProperty("--mouse-y", `${y}px`);
      });
    });
  }

  // 3. 純色背景美學微動態：當用戶視線聚焦滾入該 div 時觸發漸變至純色
  function initAmbientMorphObserver() {
    const targets = document.querySelectorAll<HTMLElement>(
      ".centerIntro, .UserShare .bg, .UserRatingBox-bottom, .new-Footer-v2"
    );
    if (!targets.length) return;

    if (!("IntersectionObserver" in window)) {
      targets.forEach((t) => t.classList.add("is-inview"));
      return;
    }

    const morphObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-inview");
            morphObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
    );

    targets.forEach((t) => morphObserver.observe(t));
  }

  function initPageInteractions() {
    initReviewsMarquee();
    initFourFeatureObserver();
    initParallaxDeco();
    initServiceSpotlight();
    initAmbientMorphObserver();
  }

  document.addEventListener("DOMContentLoaded", initPageInteractions);
  document.addEventListener("astro:page-load", initPageInteractions);
</script>
