---
/*
 * @Author: 谭洁莹
 * @Date: 2026-04-24 18:42:52
 * @LastEditTime: 2026-05-22 17:14:44
 * @FilePath: /src/pages/[...lang]/index.astro
 * @Description: 首页
 */
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import BannerSwiper from "@/components/common/BannerSwiper.astro";
import VideoCarousel from "@/components/common/VideoCarousel.astro";
import IndexEnvironment from "@/components/page/IndexEnvironment.astro";
import IndexAwards from "@/components/page/IndexAwards.astro";
import { i18nPaths, useI18n, getLocalizedHref } from "@/i18n/utils";
export function getStaticPaths() {
  return [...i18nPaths];
}
const { lang, dict } = useI18n(Astro.url);
import featureTitle from "@/assets/images/index/service-feature-title.svg";
import reviewsBgPc from "@/assets/images/index/index-reviews-bg-pc.jpg";
import reviewsBgM from "@/assets/images/index/index-reviews-bg-mb.jpg";
import reviewsGood from "@/assets/images/index/index-reviews-good.svg";
---

<BaseLayout tdkKey="home">
  <BannerSwiper />
  <section class="bg-bg-subtle pt-9 lg:pt-18 pb-13 lg:pb-16">
    <div
      class="max-w-5xl mx-auto px-[clamp(14px,7.18vw,28px)] 2xl:px-0 text-center"
    >
      <h1
        set:html={dict.home.title}
        class="title-normal pb-6 lg:pb-12 relative before:content-[''] before:h-4.5 lg:before:h-8 before:w-px before:bg-primary before:absolute before:bottom-1 lg:before:bottom-2 before:left-1/2 before:-translate-x-1/2"
      />
      <p
        set:html={dict.home.subtitle}
        class="text-primary lg:text-2xl font-[250] lg:font-thin tracking-widest mb-3 lg:mb-8"
      />
      <div
        class="text-normal space-y-8 lg:space-y-10 md:text-lg lg:text-xl text-desc text-justify lg:text-center font-light [&_strong]:font-bold leading-[2] lg:leading-[1.75] tracking-wider lg:tracking-[0.3em]"
        set:html={dict.home.intro}
      />
    </div>
  </section>
  <section class="lg:mb-25 pt-13 md:pb-22 lg:pt-38">
    <h2 class="title-normal text-center mb-11 lg:mb-18">
      {dict.home.service.title}
    </h2>
    <div class="border-t border-primary pb-4 lg:pb-70">
      <div class="max-w-7xl mx-auto"></div>
    </div>
    <div
      class="flex justify-center items-center gap-4 md:gap-10 lg:gap-18 mb-15 md:mb-40 lg:mb-66"
    >
      <a
        href={getLocalizedHref("/patient-info", lang)}
        class="flex items-center justify-center gap-4 p-6 lg:px-15 rounded-xl transition duration-300 ease bg-primary text-white hover:bg-white hover:text-primary border border-primary"
      >
        <span class="text-lg lg:text-4xl font-black lg:font-bold tracking-wider"
          >{dict.home.service.button.info}</span
        >
        <svg
          class="hidden lg:block"
          xmlns="http://www.w3.org/2000/svg"
          width="29"
          height="29"
          viewBox="0 0 29 29"
          fill="none"
          ><path
            d="m2.7 25.779 22.63-22.63"
            stroke="currentColor"
            stroke-width="5.4"
            stroke-linecap="round"></path><path
            d="M5.998 2.43H26.1v19.44"
            stroke="currentColor"
            stroke-width="4.86"
            stroke-linecap="round"></path></svg
        >
      </a>
      <a
        href={getLocalizedHref(
          "https://api.whatsapp.com/send/?phone=85269408569&text=%E6%88%91%E6%83%B3%E9%A0%90%E7%B4%84(W-15)%E7%9F%AF%E8%A6%96%E5%89%8D%E6%AA%A2%E6%9F%A5%E5%8F%8A%E8%AB%AE%E8%A9%A2",
          lang,
        )}
        class="flex items-center justify-center gap-4 p-6 lg:px-15 rounded-xl transition duration-300 ease bg-primary text-white hover:bg-white hover:text-primary border border-primary"
      >
        <span class="text-lg lg:text-4xl font-black lg:font-bold tracking-wider"
          >{dict.home.service.button.appoint}</span
        >
        <svg
          class="hidden lg:block"
          xmlns="http://www.w3.org/2000/svg"
          width="29"
          height="29"
          viewBox="0 0 29 29"
          fill="none"
          ><path
            d="m2.7 25.779 22.63-22.63"
            stroke="currentColor"
            stroke-width="5.4"
            stroke-linecap="round"></path><path
            d="M5.998 2.43H26.1v19.44"
            stroke="currentColor"
            stroke-width="4.86"
            stroke-linecap="round"></path></svg
        >
      </a>
    </div>
    <div
      class="w-full max-w-7xl mx-auto flex justify-center flex-col lg:flex-row gap-7 lg:gap-20"
    >
      <Image
        src={featureTitle}
        alt="4大特色"
        width={350}
        height={222}
        class=""
      />
      <div class="grid grid-cols-2"></div>
    </div>
  </section>
  <VideoCarousel />
  <section class="reviews lg:h-190 pt-11 lg:pt-13 pb-91 md:pb-80 lg:pb-11">
    <div class="wrapper">
      <div class="reviews-main">
        <h2 class="title-normal text-center">{dict.home.reviews.title}</h2>
        <Image
          src={reviewsGood}
          alt=""
          width={239}
          height={161}
          class="absolute w-25 lg:w-59 -top-6 right-4 lg:top-auto lg:right-auto lg:-left-37 lg:-bottom-21 z-10"
        />
      </div>
    </div>
  </section>
  <section class="book bg-primary text-white relative">
    <div class="wrapper pt-9 lg:pt-22 pb-55 lg:pb-17">
      <h2 class="title-normal text-white text-center mb-5 lg:mb-15">
        {dict.home.book.title}
      </h2>
      <div
        set:html={dict.home.book.intro}
        class="lg:w-146 text-center lg:text-justify leading-[1.75] tracking-[0.3em] lg:text-xl font-light [&_strong]:font-bold"
      />
      <div class="book-button-group">
        <a
          href={getLocalizedHref("/patient-info", lang)}
          target="_blank"
          rel="noopener noreferrer"
          class="book-button"
        >
          <div
            class="book-check text-white hover:text-primary bg-primary hover:bg-white"
          >
            <svg
              class="w-19 md:w-25 xl:w-40"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 79 47"
              fill="none"
            >
              <path
                d="M21.384 27.108 17.5 35.01m-1.586-8.45-2.338 4.75m51.414-3.927-3.887 7.9m-1.586-8.448-2.337 4.751M37.367 6.825c-2.373.513-4.402 2.131-5.468 4.403a10.8 10.8 0 0 1-6.034 5.54m26.622.045a10.78 10.78 0 0 1-6.17-5.598c-1.029-2.194-2.962-3.774-5.232-4.338m.273-5.037h8.235c6.158 0 11.149 5.032 11.149 11.24m-43.261.932v-.934c0-6.209 4.991-11.24 11.15-11.24h8.281"
                stroke="currentColor"
                stroke-width="1.927"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M39.687 7.35c1.737-.285 2.917-1.935 2.635-3.687s-1.92-2.941-3.657-2.657-2.917 1.935-2.635 3.687 1.92 2.941 3.657 2.657m-6.352 21.902a7.5 7.5 0 0 1 5.76-2.692h.018a7.5 7.5 0 0 1 5.766 2.72l.03.034m-40.36 8.759c2.526 4.38 7.234 7.323 12.622 7.323 5.387 0 10.013-2.893 12.554-7.21M3.527 34.977l-1.77.766a16.4 16.4 0 0 1-.793-5.059c0-9.006 7.241-16.309 16.176-16.309 8.936 0 16.177 7.3 16.177 16.31 0 1.765-.279 3.466-.793 5.058l-1.873-.846m17.844 3.176c2.526 4.38 7.234 7.323 12.622 7.323s10.013-2.893 12.554-7.21m-26.197-3.209-1.771.766a16.4 16.4 0 0 1-.793-5.059c0-9.006 7.241-16.309 16.177-16.309s16.176 7.3 16.176 16.31a16.4 16.4 0 0 1-.792 5.058l-1.873-.846M14.448 11.6v4.744M63.773 11.6v4.744"
                stroke="currentColor"
                stroke-width="1.927"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M18.74 39.938c5.436-.89 9.128-6.055 8.246-11.537-.883-5.482-6.006-9.204-11.443-8.314s-9.13 6.055-8.247 11.536c.883 5.482 6.006 9.205 11.443 8.315m43.944-.002c5.437-.89 9.129-6.055 8.246-11.536-.882-5.482-6.005-9.205-11.443-8.315s-9.129 6.055-8.246 11.537 6.005 9.204 11.442 8.314"
                stroke="currentColor"
                stroke-width="1.927"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span class="md:text-xl xl:text-[24px,1.875vw,36px] 2xl:text-4xl font-black"
              >{dict.home.book.button.appoint}</span
            >
          </div>
        </a>
        <a
          href={getLocalizedHref("/ophthalmicInfo/AppointForm", lang)}
          target="_blank"
          rel="noopener noreferrer"
          class="book-button group"
        >
          <div class="book-lecture">
            <svg
              class="w-16 md:w-22 xl:w-34 group-hover:animate-shake origin-center"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 68 51"
              fill="none"
            >
              <path
                d="M52.27 12.365h11.572c1.482 0 2.68 1.183 2.68 2.636v26.537c0 1.453-1.198 2.636-2.68 2.636h-6.014l-3.335 5.259-3.335-5.259H26.446c-1.482 0-2.68-1.183-2.68-2.636v-2.922"
                stroke="#4570b6"
                stroke-width="1.927"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M43.718.963H3.814a2.86 2.86 0 0 0-2.85 2.85v25.654a2.86 2.86 0 0 0 2.85 2.85h6.413l3.563 5.7 3.563-5.7h26.365a2.86 2.86 0 0 0 2.85-2.85V3.814a2.86 2.86 0 0 0-2.85-2.85"
                stroke="#4570b6"
                stroke-width="1.927"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M23.768 14.754a1.887 1.887 0 1 1-.001 3.774 1.887 1.887 0 0 1 0-3.774Zm-11.404 0a1.887 1.887 0 1 1 0 3.774 1.887 1.887 0 0 1 0-3.774Zm22.803 0a1.887 1.887 0 1 1 0 3.774 1.887 1.887 0 0 1 0-3.774Z"
                fill="#fff"
                stroke="#4570b6"
                stroke-width="1.927"></path>
            </svg>
            <span
              class="md:text-xl xl:text-[24px,1.875vw,36px] 2xl:text-4xl font-black text-primary"
              >{dict.home.book.button.lecture}</span
            >
          </div>
        </a>
      </div>
    </div>
  </section>
  <IndexEnvironment />
  <section
    class="awards mb-11 lg:mb-62 flex flex-col lg:flex-row gap-7 md:gap-10 lg:gap-16"
  >
    <h2
      class="title-normal text-center lg:py-8 lg:pr-11 lg:border-r-2 lg:border-primary"
    >
      {dict.home.awards.title}
    </h2>
    <IndexAwards />
  </section>
</BaseLayout>
<style
  lang="scss"
  define:vars={{
    bgPc: `url(${reviewsBgPc.src})`,
    bgM: `url(${reviewsBgM.src})`,
  }}
>
  %book-button {
    aspect-ratio: 1/1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 12px;
    border: 1px solid #fff;
    border-radius: 50%;
  }
  %book-before {
    content: "";
    width: 100%;
    height: 100%;
    border-radius: 50%;
    position: absolute;
    right: -4px;
    bottom: -4px;
    background-color: var(--color-primary);
    border: 1px solid #fff;
    z-index: -1;
  }
  .book {
    .book-button {
      position: absolute;
      z-index: 20;
      &:first-child {
        left: 28px;
        bottom: 48px;
        width: clamp(140px, 41vw, 160px);
      }
      &:last-child {
        right: 40px;
        bottom: -52px;
        width: clamp(144px, 43vw, 168px);
      }
    }
    .book-check {
      @extend %book-button;
      position: relative;
      width: 100%;
      height: 100%;
      transition:
        background-color 300ms ease-in-out,
        color 300ms ease-in-out;
      &::before {
        @extend %book-before;
        opacity: 0;
        transition: opacity 0.3s ease-in-out;
      }
      &:hover::before {
        opacity: 100;
      }
    }
    .book-lecture {
      @extend %book-button;
      position: relative;
      width: 100%;
      height: 100%;
      background-color: #fff;
      &::before {
        @extend %book-before;
      }
    }
  }
  .reviews {
    background-image: var(--bgM);
    background-size: cover;
    background-position: bottom;
    .reviews-main {
      position: relative;
      border: 1px solid var(--color-primary);
      width: 100%;
      height: 436px;
      padding: 48px 32px 0 32px;
      background-color: #fff;
      &::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: calc(100% + 1px);
        aspect-ratio: 13 / 1;
        background-image: url("data:image/svg+xml;base64,");
        background-repeat: no-repeat;
        background-size: cover;
      }
    }
  }
  @media screen and (min-width: 768px) {
    .reviews {
      background-position: center 80%;
      .reviews-main {
        padding-top: 72px;
        height: 520px;
      }
    }
  }
  @media screen and (min-width: 1024px) {
    .reviews {
      background-image: var(--bgPc);
      background-position: bottom;
      .reviews-main {
        width: 652px;
        height: 660px;
        padding: 96px 108px 40px 108px;
      }
    }
    .awards {
      margin-left: calc((100vw - 1280px) / 2);
    }
  }
  @media screen and (min-width: 1280px) {
    .book {
      .book-button {
        &:first-child {
          width: 17.292vw;
          top: 60px;
          right: 22.5vw;
          bottom: auto;
          left: auto;
        }
        &:last-child {
          width: 18.125vw;
          right: 9.1vw;
          bottom: -48px;
        }
      }

      .book-lecture,
      .book-check {
        &::before {
          right: -8px;
          bottom: -8px;
        }
      }
    }
  }
  @media screen and (min-width: 1560px) {
    .book {
      .book-button {
        &:first-child {
          width: 17.292vw;
          top: 40px;
          right: 27.5vw;
          bottom: auto;
          left: auto;
        }
        &:last-child {
          width: 18.125vw;
          right: 11.1vw;
          bottom: -84px;
        }
      }
    }
  }
</style>
