---
import "@/styles/global.css";
import Header from "@/components/global/Header.astro";
import Footer from "@/components/global/Footer.astro";
import ShareMobile from "@/components/global/ShareMobile.astro";
import MobileBottom from "@/components/global/MobileBottom.astro";
import SidebarDesktop from "@/components/global/SidebarDesktop.astro";
import Backtop from "@/components/global/Backtop.astro";
import { useI18n } from "@/i18n/utils";
import { ui } from "@/i18n/ui";
type TDKKeys = keyof (typeof ui)["zh-hk"]["tdk"];
interface Props {
  tdkKey?: TDKKeys; // 接收如 "home" 或 "about"
  seo?: any; // 兼容某些特殊页面手动传入完整的 SEO 对象
}
const { tdkKey, seo } = Astro.props;
const { dict, lang } = useI18n(Astro.url);
let finalSeo = seo || dict.tdk.home;
if (tdkKey && dict.tdk[tdkKey]) {
  finalSeo = dict.tdk[tdkKey];
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{finalSeo.title}</title>
    <meta name="description" content={finalSeo.description} />
    <meta name="keywords" content={finalSeo.keywords} />
    <!-- <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-XXXXXXX");
    </script> -->
  </head>
  <body>
    <Header />
    <!-- <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-XXXXXXX" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript> -->
    <main>
      <slot />
    </main>
    <SidebarDesktop />
    <Backtop />
    <ShareMobile />
    <MobileBottom />
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    overflow: hidden;
  }
</style>
