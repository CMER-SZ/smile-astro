---
/**
 * SchemaBreadcrumb.astro
 * 麵包屑結構化數據 BreadcrumbList
 */
interface Item {
  name: string;
  url: string;
}

interface Props {
  items: Item[];
}

const { items = [] } = Astro.props;
const siteUrl = Astro.site?.origin || "https://smile.hkcmereye.com";

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": item.url.startsWith("http") ? item.url : new URL(item.url, siteUrl).href
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
