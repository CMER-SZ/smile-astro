<script>
  import Swiper from "swiper";
  import { Autoplay, FreeMode } from "swiper/modules";
  import "swiper/css";

  function initUserRatingSwiper() {
    const el = document.getElementById("userRatingSwiper");
    if (!el) return;
    if ((el as any).swiper) {
      (el as any).swiper.destroy(true, true);
    }

    let isDragging = false;
    let dragDist = 0;
    let startY = 0;

    const swiper = new Swiper(el, {
      modules: [Autoplay, FreeMode],
      direction: "vertical",
      loop: true,
      slidesPerView: "auto",
      spaceBetween: 0,
      speed: 1800, // 速度加快，流暢快速滾動推進
      autoplay: {
        delay: 1500, // 1.5s 即推進下一條，節奏輕快敏捷
        disableOnInteraction: false,
        pauseOnMouseEnter: true, // 鼠標懸停自動暫停
      },
      freeMode: {
        enabled: true,
        momentum: true,
        momentumRatio: 1.5,
      },
      allowTouchMove: true, // 支援滑鼠拖拽滑動
      grabCursor: true,
    });

    // 拖拽與點擊分離：拖拽位移 > 6px 時攔截 a 標籤跳轉
    el.addEventListener("mousedown", (e) => {
      startY = e.pageY;
      dragDist = 0;
      isDragging = false;
    });

    el.addEventListener("mousemove", (e) => {
      dragDist = Math.abs(e.pageY - startY);
      if (dragDist > 6) {
        isDragging = true;
      }
    });

    el.querySelectorAll<HTMLAnchorElement>(".swiper-slide").forEach((link) => {
      link.addEventListener("click", (e) => {
        if (isDragging) {
          e.preventDefault();
          e.stopPropagation();
        }
      });
    });
  }

  document.addEventListener("DOMContentLoaded", initUserRatingSwiper);
  document.addEventListener("astro:page-load", initUserRatingSwiper);
</script>

<style>
  /* 講座按鈕（.UserShareBox-Link-btntwo）專屬防護：hover / active / focus 保持白底不變，杜絕深藍底色 */
  .UserShareBox-Link-btntwo,
  .UserShareBox-Link-btntwo:hover,
  .UserShareBox-Link-btntwo:focus,
  .UserShareBox-Link-btntwo:active {
    background: #ffffff !important;
    background-color: #ffffff !important;
  }
  .UserShareBox-Link-btntwo:hover span,
  .UserShareBox-Link-btntwo:focus span,
  .UserShareBox-Link-btntwo:active span {
    color: #4570b6 !important;
  }
  .UserShareBox-Link-btntwo::after,
  .UserShareBox-Link-btntwo:hover::after,
  .UserShareBox-Link-btntwo:focus::after,
  .UserShareBox-Link-btntwo:active::after {
    display: none !important;
    content: none !important;
  }
</style>
