---
import { Image } from "astro:assets";
import { ALL_VIDEOS, VIDEO_TABS, type VideoType } from "@/data/videoData";
import { useI18n } from "@/i18n/utils";
const { dict } = useI18n(Astro.url);
const defaultType = "smilepro";
const typeConfig: Record<VideoType, { bg: string; label: string; color: string }> = {
  smilepro: { bg: "bg-[#4570B6]", label: "SMILE Pro", color: "#4570B6" },
  smile: { bg: "bg-[#30ABE2]", label: "SMILE", color: "#30ABE2" },
  icl: { bg: "bg-[#EB981A]", label: "ICL", color: "#EB981A" },
};
---

<section class="lg:max-w-7xl mx-auto mb-12 lg:mb-17">
  <div class="search mb-10 lg:mb-18 px-7 md:px-0">
    <div class="border border-primary flex w-full md:w-fit mx-auto">
      <div class="center p-3 bg-primary size-13">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="25" viewBox="0 0 24 25" fill="none">
          <g clip-path="url(#a)">
            <path
              d="M15.818 18.349c-4.536 3.166-10.583 2.091-13.81-2.199-3.101-4.124-2.56-9.959 1.276-13.518 3.739-3.47 9.54-3.512 13.392-.103 3.983 3.526 4.63 9.726 1.053 14.057q.194.209.395.418l5.45 5.7c.555.58.568 1.395.035 1.919-.538.529-1.35.5-1.905-.076-.928-.965-1.85-1.935-2.776-2.902q-1.481-1.547-2.961-3.096c-.056-.058-.098-.13-.15-.2zm-5.793-.797c4.077.016 7.403-3.315 7.425-7.434.021-4.105-3.288-7.46-7.377-7.481-4.096-.022-7.433 3.31-7.449 7.433-.015 4.118 3.296 7.465 7.401 7.482"
              fill="#fff"
            >
            </path>
          </g>
        </svg>
      </div>
      <div class="py-2 px-3">
        <input
          id="video-search"
          type="search"
          placeholder={dict.page.video.search}
          class="w-full md:min-w-xs focus:outline-none text-desc xs:text-xl font-light leading-[1.75] tracking-[0.3em]"
          maxlength="20"
        />
      </div>
    </div>
  </div>
  <div
    class="grid grid-cols-3 text-center text-xl lg:text-3xl font-en font-bold lg:tracking-[0.25em] mb-12 md:mb-20 lg:mb-30"
    id="video-tabs-container"
  >
    {
      VIDEO_TABS.map((tab) => (
        <button
          data-tab-key={tab.key}
          class={`py-7 transition-colors cursor-pointer ${
            defaultType === tab.key ? "bg-primary text-white" : "text-primary border-b border-[#4570b64d]"
          }`}
        >
          {tab.label}
        </button>
      ))
    }
  </div>

  <div class="video-list overflow-hidden grid grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-9 w-full lg:w-fit mx-auto">
    {
      ALL_VIDEOS.map((item, index) => {
        const hasDefault = item.type.includes(defaultType);
        const cardDisplayType = hasDefault ? defaultType : item.type[0];
        const currentConfig = typeConfig[cardDisplayType];
        return (
          <div
            class="video-item shrink-0 grow-0 aspect-3/5 w-full lg:w-66 overflow-hidden group"
            data-types={item.type.join(",")}
            data-name={item.name || ""}
            data-en-name={item.enName || ""}
            style={{ display: hasDefault ? "block" : "none" }}
          >
            <a href={item.link} target="_blank" rel="noopener noreferrer" class="block size-full">
              <Image
                src={item.img}
                alt={item.name}
                width={265}
                height={439}
                class="size-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading={index < 4 ? "eager" : "lazy"}
                draggable="false"
              />
              {currentConfig && (
                <span
                  data-label
                  data-smilepro-bg="bg-[#4570B6]"
                  data-smilepro-text="SMILE Pro"
                  data-smile-bg="bg-[#30ABE2]"
                  data-smile-text="SMILE"
                  data-icl-bg="bg-[#EB981A]"
                  data-icl-text="ICL"
                  class={`absolute top-3 right-3 lg:top-4 z-10 text-white text-base lg:text-xl px-4 py-1 rounded-full font-en font-bold ${currentConfig.bg}`}
                >
                  {currentConfig.label}
                </span>
              )}
              <div class="z-10 absolute bottom-3 left-3 right-3 text-white whitespace-nowarp">
                <h3
                  set:html={item.title}
                  class="video-title text-sm lg:text-base font-bold tracking-wider leading-normal mb-1 pb-4 lg:pb-7"
                  style={currentConfig ? `--title-color: ${currentConfig.color}` : ""}
                />
                <p class="flex flex-wrap items-baseline gap-x-1.5 mt-1">
                  {item.name && <span class="text-sm lg:text-base font-semibold tracking-wider">{item.name}</span>}
                  {item.enName && <span class="text-xs lg:text-sm font-bold tracking-wider">{item.enName}</span>}
                </p>
              </div>
            </a>
          </div>
        );
      })
    }
  </div>
</section>
<script>
  function initVideoFilter() {
    const container = document.getElementById("video-tabs-container");
    const searchInput = document.getElementById("video-search") as HTMLInputElement | null;
    if (!container) return;

    const tabs = container.querySelectorAll("button");

    // 状态管理：保存当前选中的 Tab 类型和当前的搜索关键词
    let currentType = "smilepro"; // 需与 Astro 模板中的 defaultType 保持一致
    let searchQuery = "";

    // 1. 绑定 Tabs 点击事件
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const activeType = tab.getAttribute("data-tab-key");
        if (!activeType) return;

        currentType = activeType;

        // 切换 Tab 激活状态的 class
        tabs.forEach((t) => {
          if (t === tab) {
            t.className = "py-7 transition-colors cursor-pointer bg-primary text-white";
          } else {
            t.className = "py-7 transition-colors cursor-pointer text-primary border-b border-[#4570b64d]";
          }
        });

        // 执行联合过滤
        applyFilter();
      });
    });

    // 2. 绑定 搜索框 输入事件
    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        const target = e.target as HTMLInputElement;
        // 转换为小写并去除两端空格，实现英文不区分大小写
        searchQuery = target.value.trim().toLowerCase();

        // 执行联合过滤
        applyFilter();
      });
    }

    // 3. 联合过滤核心逻辑
    function applyFilter() {
      const videoList = document.querySelectorAll(".video-item");

      videoList.forEach((card) => {
        const htmlCard = card as HTMLElement;

        // 获取当前卡片的数据
        const typesStr = htmlCard.getAttribute("data-types") || "";
        const typesArray = typesStr.split(",");
        const name = htmlCard.getAttribute("data-name") || "";
        const enName = (htmlCard.getAttribute("data-en-name") || "").toLowerCase(); // 转小写用于匹配

        // 条件 1: 判定 Tab 分类是否匹配
        const matchesType = typesArray.includes(currentType);

        // 条件 2: 判定 搜索框 关键词是否匹配 (中文名包含 或 英文名包含)
        // 如果 searchQuery 为空，则默认视为匹配成功
        const matchesSearch = !searchQuery || name.includes(searchQuery) || enName.includes(searchQuery);

        // 只有两个条件同时满足才显示
        if (matchesType && matchesSearch) {
          htmlCard.style.display = "block";

          const labelEl = htmlCard.querySelector("[data-label]") as HTMLElement | null;
          const titleEl = htmlCard.querySelector(".video-title") as HTMLElement | null;

          if (labelEl) {
            const targetBg = labelEl.getAttribute(`data-${currentType}-bg`);
            const targetText = labelEl.getAttribute(`data-${currentType}-text`);
            const targetColor = labelEl.getAttribute(`data-${currentType}-color`);

            if (targetBg && targetText) {
              labelEl.textContent = targetText;
              labelEl.classList.remove("bg-[#4570B6]", "bg-[#30ABE2]", "bg-[#EB981A]");
              labelEl.classList.add(targetBg);
            }

            if (titleEl && targetColor) {
              titleEl.style.setProperty("--title-color", targetColor);
            }
          }
        } else {
          htmlCard.style.display = "none";
        }
      });
    }
  }

  // 确保在 Astro 首屏和启用 ViewTransitions 时都能正常运行
  initVideoFilter();
  document.addEventListener("astro:page-load", initVideoFilter);
</script>
<style>
  .video-item {
    position: relative;
    &::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, transparent 50%, rgba(0, 0, 0, 0.2));
      pointer-events: none;
    }
  }
  .video-title {
    position: relative;
    &::before {
      content: "";
      position: absolute;
      bottom: 8px;
      left: 0;
      height: 2px;
      width: 52px;
      background: var(--title-color, white);
      @media screen and (min-width: 1024px) {
        bottom: 16px;
        height: 3px;
        width: 68px;
      }
    }
  }
</style>
