---
import { Image } from "astro:assets";
import mbBanner1 from "@/assets/images/index/environment-mb-01.jpg";
import pcBanner1 from "@/assets/images/index/environment-pc-01.jpg";
import mbBanner2 from "@/assets/images/index/environment-mb-02.jpg";
import pcBanner2 from "@/assets/images/index/environment-pc-02.jpg";
import mbBanner3 from "@/assets/images/index/environment-mb-03.jpg";
import pcBanner3 from "@/assets/images/index/environment-pc-03.jpg";
import mbBanner4 from "@/assets/images/index/environment-mb-04.jpg";
import pcBanner4 from "@/assets/images/index/environment-pc-04.jpg";

const banners = [
  {
    id: 1,
    pc: pcBanner1,
    mb: mbBanner1,
    title: "香港希瑪微笑矯視中心 - 現代化眼科接待大堂與寬敞舒適等候區",
    alt: "香港希瑪微笑矯視中心現代化接待大堂環境",
  },
  {
    id: 2,
    pc: pcBanner2,
    mb: mbBanner2,
    title: "香港希瑪微笑矯視中心 - 德國蔡司國際標準百級無菌層流手術室",
    alt: "希瑪微笑矯視中心德國蔡司全飛秒無菌手術室",
  },
  {
    id: 3,
    pc: pcBanner3,
    mb: mbBanner3,
    title: "香港希瑪微笑矯視中心 - 精密屈光術前多維度眼睛檢查室與儀器設備",
    alt: "希瑪微笑矯視精密術前檢查室與儀器設備",
  },
  {
    id: 4,
    pc: pcBanner4,
    mb: mbBanner4,
    title: "香港希瑪微笑矯視中心 - 一對一專科醫生獨立諮詢與精準診症室",
    alt: "希瑪微笑矯視專科醫生獨立諮詢與診症空間",
  },
];
---

<section class="section-environment" aria-label="希瑪微笑矯視中心門市與手術室環境展示">
  <div class="swiper env-carousel-wrapper" id="envCarousel">
    <div class="swiper-wrapper">
      {
        banners.map((banner, index) => (
          <div class="swiper-slide env-carousel-slide">
            <picture class="block w-full h-full">
              <source media="(min-width: 1024px)" srcset={banner.pc.src} width="1442" height="813" />
              <Image
                src={banner.mb}
                alt={banner.alt}
                title={banner.title}
                width={749}
                height={520}
                format="webp"
                loading={index === 0 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : "low"}
                class="w-full h-full object-cover"
              />
            </picture>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss">
  .section-environment {
    width: 100%;
    position: relative;
    z-index: 1;
    margin-bottom: 2rem;
    @media (min-width: 768px) {
      margin-bottom: 4rem;
    }
    @media (min-width: 1024px) {
      margin-bottom: 6rem;
    }
  }
  .env-carousel-wrapper {
    width: 100%;
    overflow: hidden;
    position: relative;
    background-color: #fff;
    @media (min-width: 1024px) {
      max-height: 450px;
      height: 450px;
    }

    img {
      width: 100%;
      aspect-ratio: 749 / 520;
      object-fit: cover;
      @media (min-width: 1024px) {
        aspect-ratio: auto;
        height: 450px !important;
        max-height: 450px !important;
        object-fit: cover;
      }
    }

    :global(.swiper-wrapper) {
      display: flex !important;
      flex-direction: row !important;
      width: 100%;
      height: 100%;
      position: relative;
      transition-timing-function: linear !important;
    }
    :global(.swiper-slide) {
      flex-shrink: 0 !important;
      height: 100% !important;
      position: relative;
      @media (min-width: 1024px) {
        max-height: 450px !important;
        height: 450px !important;
      }
    }
  }
</style>

<script>
  import Swiper from "swiper";
  import { Autoplay } from "swiper/modules";
  import "swiper/css";

  function startEnvCarousel() {
    const el = document.getElementById("envCarousel");
    if (!el) return;
    if ((el as any).swiper) {
      (el as any).swiper.destroy(true, true);
    }

    new Swiper(el, {
      modules: [Autoplay],
      loop: true,
      speed: 5000,
      autoplay: {
        delay: 0,
        disableOnInteraction: false,
      },
      spaceBetween: 0,
      slidesPerView: 1,
      breakpoints: {
        768: {
          slidesPerView: 2,
        },
        1280: {
          slidesPerView: 2.2,
        },
        1560: {
          slidesPerView: 2.5,
        },
      },
    });
  }

  document.addEventListener("DOMContentLoaded", startEnvCarousel);
  document.addEventListener("astro:page-load", startEnvCarousel);
</script>
