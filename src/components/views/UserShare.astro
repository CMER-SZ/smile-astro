---
import { SHARE_DATA } from "@/data/shareData";

const colorMap: Record<string, string> = {
  "SMILE Pro": "#4570B6",
  "ICL": "#EB981A",
  "CLEAR-Vision": "#5FB947",
  "SMILE": "#30ABE2",
};

function getColor(type: string) {
  return colorMap[type] || "#4570B6";
}
---

<section class="UserShare overflow-hidden">
  <div class="bg">
    <div class="container UserShareContainer">
      <div class="UserShareBox">
        <div class="UserShareBox-title">
          <h2 class="title-share">用家分享</h2>
          <div class="UserShareBox-title-text">
            <img
              class="d-block"
              decoding="async"
              src="https://statichk.cmermedical.com/smile/VisionCorrectionCenter/userShare/boxShare-newtitle-pc.png"
              alt="更舒適生活從希瑪矯視開始 - 聽聽各位真實用家親身感受"
              title="希瑪微笑矯視用家真實口碑分享"
              loading="lazy"
              width="100%"
              height="100%"
              srcset="
                https://statichk.cmermedical.com/smile/VisionCorrectionCenter/userShare/boxShare-newtitle-mb.svg 400w,
                https://statichk.cmermedical.com/smile/VisionCorrectionCenter/userShare/boxShare-newtitle-mb.svg 640w,
                https://statichk.cmermedical.com/smile/VisionCorrectionCenter/userShare/boxShare-newtitle-pc.png
              "
              sizes="(max-width: 992px) 100vw, 1216px"
            />
            <p>聽聽各位真實用家親身感受</p>
          </div>
        </div>

        <ul class="UserShareBox-list" id="UserShareBoxlist">
          {
            SHARE_DATA.map((item) => (
              <li class="UserShareBox-list-item">
                <a
                  class="UserShareBox-list-item-link"
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-cta="user_share"
                  title={`觀看 ${item.nameCn || item.nameEn} 的 ${item.type} 矯視真實用家心得分享影片`}
                >
                  <img
                    src={item.img}
                    alt={`${item.nameCn || item.nameEn} - 香港希瑪 ${item.type} 矯視用家分享`}
                    title={`${item.nameCn || item.nameEn} ${item.type} 微笑矯視親身感受`}
                    loading="lazy"
                  />
                  <span
                    class="UserShareBox-list-item-link-title"
                    style={`background-color: ${getColor(item.type)}`}
                  >
                    {item.type}
                  </span>
                  <div class="UserShareBox-list-item-link-text">
                    {item.text.map((text) => (
                      <p>{text}</p>
                    ))}
                    <i style={`background-color: ${getColor(item.type)}`} />
                    <div class="UserShareBox-list-item-link-text-name">
                      <span>{item.nameCn}</span>&nbsp;
                      <span class="UserShareBox-list-item-link-text-name-en">{item.nameEn}</span>
                    </div>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  function initUserShareDrag() {
    const list = document.getElementById("UserShareBoxlist");
    if (!list) return;

    let isDown = false;
    let downX = 0;
    let downY = 0;
    let startScrollLeft = 0;
    let hasDragged = false;
    let dragLockTimer: ReturnType<typeof setTimeout> | null = null;
    const DRAG_THRESHOLD = 6; // 6px 閾值：位移超過 6px 視為拖拽，否則為精準點擊

    // 1. 禁用瀏覽器原生拖拽行為 (防止圖片與連結被拽出幽靈重影)
    list.addEventListener("dragstart", (e) => e.preventDefault());

    // 2. 滑鼠滾輪橫向滾動支援
    list.addEventListener(
      "wheel",
      (e) => {
        if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
          e.preventDefault();
          list.scrollLeft += e.deltaY * 1.6;
        }
      },
      { passive: false }
    );

    // 3. 高靈敏度平滑拖拽 (速度放大 2.2x)
    list.addEventListener("mousedown", (e) => {
      if (window.innerWidth <= 992) return;
      isDown = true;
      hasDragged = false;
      downX = e.pageX;
      downY = e.pageY;
      startScrollLeft = list.scrollLeft;
      list.style.cursor = "grabbing";
      list.style.userSelect = "none";
      if (dragLockTimer) clearTimeout(dragLockTimer);
    });

    window.addEventListener("mousemove", (e) => {
      if (!isDown || window.innerWidth <= 992) return;
      const distX = e.pageX - downX;
      const distY = e.pageY - downY;

      if (!hasDragged && Math.hypot(distX, distY) > DRAG_THRESHOLD) {
        hasDragged = true;
      }

      if (hasDragged) {
        e.preventDefault();
        // 2.2x 速度放大係數，拖拽無延遲、輕快敏捷
        const walk = distX * 2.2;
        const maxScroll = list.scrollWidth - list.clientWidth;
        list.scrollLeft = Math.max(0, Math.min(maxScroll, startScrollLeft - walk));
      }
    });

    window.addEventListener("mouseup", () => {
      if (!isDown) return;
      isDown = false;
      list.style.cursor = "grab";
      list.style.removeProperty("user-select");

      if (hasDragged) {
        // 保持 250ms 鎖定，徹底杜絕鬆開滑鼠瞬間誤觸 click 跳轉
        dragLockTimer = setTimeout(() => {
          hasDragged = false;
        }, 250);
      }
    });

    // 4. 點擊與拖拽絕對分離：拖拽過後精準攔截，純點擊無阻礙直達
    list.querySelectorAll<HTMLAnchorElement>(".UserShareBox-list-item-link").forEach((link) => {
      link.addEventListener("click", (e) => {
        if (hasDragged) {
          e.preventDefault();
          e.stopImmediatePropagation();
          return false;
        }
      });
    });
  }

  document.addEventListener("DOMContentLoaded", initUserShareDrag);
  document.addEventListener("astro:page-load", initUserShareDrag);
</script>
