<section class="marquee-carousel" aria-labelledby="awards-heading">
  <!-- 左側/頂部 標題 (含桌面端藍色垂直裝飾線) -->
  <div class="marquee-carousel-title">
    <h2 id="awards-heading">{sectionTitle}</h2>
  </div>

  <!-- 右側/底部 無縫無限滾動軌道 (Swiper 驅動，支援全自由鼠標/觸摸拖拽滑動與平滑自動巡遊) -->
  <div class="swiperWrap swiper" id="awardsSwiper">
    <div class="swiper-wrapper">
      {
        [...awards, ...awards].map((award) => {
          const isRemote = typeof award.img === "string";
          const isSvg = !isRemote && ((award.img as any).format === "svg" || (award.img as any).src?.includes(".svg"));

          return (
            <div class="swiper-slide award-item">
              {isRemote ? (
                <img
                  src={award.img as string}
                  alt={award.alt}
                  title={award.title}
                  width="132"
                  height="132"
                  loading="lazy"
                  class="award-img object-contain"
                />
              ) : (
                <Image
                  src={award.img as any}
                  alt={award.alt}
                  title={award.title}
                  width={132}
                  height={132}
                  format={isSvg ? "svg" : "webp"}
                  loading="lazy"
                  class="award-img"
                />
              )}
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style lang="scss">
  .marquee-carousel {
    width: 100%;
    overflow: hidden;
  }

  /* 移動端樣式 (< 992px) - 移除左右兩處 padding，實現 full width 滿寬展示 */
  @media screen and (max-width: 991px) {
    .marquee-carousel {
      margin-top: 36px;
      margin-bottom: 30px;
      padding-left: 0 !important;
      padding-right: 0 !important;

      .marquee-carousel-title {
        padding-left: 15px;
        padding-right: 15px;
        h2 {
          text-align: center;
          color: #4570b6;
          font-family: -apple-system, BlinkMacSystemFont, "PingFang HK", "PingFang TC", "Noto Sans HK", "Microsoft JhengHei", sans-serif;
          font-size: 24px;
          font-style: normal;
          font-weight: 700;
          line-height: 1.25;
          letter-spacing: 2px;
          margin-bottom: 16px;
        }
      }

      .swiperWrap {
        width: 100%;
        overflow: hidden;
        position: relative;
        cursor: grab;

        &:active {
          cursor: grabbing;
        }

        :global(.swiper-wrapper) {
          display: flex;
          align-items: center;
          transition-timing-function: linear !important;
        }

        .award-item {
          width: auto !important;
          height: 100px;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 0 10px;
          flex-shrink: 0;

          .award-img {
            max-width: 100px;
            max-height: 85px;
            width: auto;
            height: auto;
            object-fit: contain;
            /* 嚴禁使用 drop-shadow，確保非透明背景圖形絕無單獨多餘黑影 */
            filter: none !important;
          }
        }
      }
    }
  }

  /* 桌面端樣式 (>= 992px) - 1280px 罐頭標準對齊 */
  @media screen and (min-width: 992px) {
    .marquee-carousel {
      max-width: 1280px !important;
      margin-left: auto !important;
      margin-right: auto !important;
      padding-left: 15px !important;
      padding-right: 15px !important;
      margin-top: clamp(60px, 6vw, 100px);
      margin-bottom: clamp(30px, 3.5vw, 60px);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: clamp(40px, 5vw, 80px);
      overflow: hidden;

      .marquee-carousel-title {
        flex-shrink: 0;
        position: relative;
        padding-right: clamp(35px, 3vw, 55px);

        h2 {
          color: #4570b6;
          font-family: -apple-system, BlinkMacSystemFont, "PingFang HK", "PingFang TC", "Noto Sans HK", "Microsoft JhengHei", sans-serif;
          font-size: clamp(24px, 1.8vw, 30px);
          font-style: normal;
          font-weight: 900;
          line-height: 1;
          letter-spacing: 3px;
          white-space: nowrap;
        }

        &::after {
          content: "";
          position: absolute;
          right: 0;
          top: 50%;
          transform: translateY(-50%);
          height: 75px;
          width: 2px;
          background: #4570b6;
        }
      }

      .swiperWrap {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        position: relative;
        cursor: grab;
        mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
        -webkit-mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);


        &:active {
          cursor: grabbing;
        }

        :global(.swiper-wrapper) {
          display: flex;
          align-items: center;
          transition-timing-function: linear !important;
        }

        .award-item {
          width: auto !important;
          height: clamp(120px, 9vw, 150px);
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 0 clamp(16px, 1.5vw, 24px);
          flex-shrink: 0;

          .award-img {
            max-width: 140px;
            max-height: clamp(100px, 7vw, 120px);
            width: auto;
            height: auto;
            object-fit: contain;
            /* 徹底剔除 drop-shadow 濾鏡，徹底杜絕 rectangular 邊界陰影問題 */
            filter: none !important;
            transition: transform 0.25s ease;
          }

          &:hover .award-img {
            transform: scale(1.08);
          }
        }
      }
    }
  }
</style>

<script>
  import Swiper from "swiper";
  import { Autoplay, FreeMode } from "swiper/modules";
  import "swiper/css";

  function initAwardsSwiper() {
    const el = document.getElementById("awardsSwiper");
    if (!el) return;
    if ((el as any).swiper) {
      (el as any).swiper.destroy(true, true);
    }

    new Swiper(el, {
      modules: [Autoplay, FreeMode],
      loop: true,
      slidesPerView: "auto",
      spaceBetween: 0,
      speed: 4000,
      autoplay: {
        delay: 0,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      },
      freeMode: {
        enabled: true,
        momentum: true,
        momentumRatio: 1.2,
      },
      allowTouchMove: true,
      grabCursor: true,
    });
  }

  document.addEventListener("DOMContentLoaded", initAwardsSwiper);
  document.addEventListener("astro:page-load", initAwardsSwiper);
</script>
