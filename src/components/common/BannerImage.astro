---
/*
 * @Author: Antigravity AI
 * @Date: 2026-09-01
 * @FilePath: /src/components/common/BannerImage.astro
 * @Description: 頂級響應式內頁 Banner 組件 (100% 消除 CLS 抖動 + LCP 極速加載 + 自動 WebP/AVIF 雙端 srcset)
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  pcSrc: ImageMetadata | string;
  mbSrc?: ImageMetadata | string;
  alt: string;
  title?: string;
  isLcp?: boolean; // 首屏核心圖片標記 (預設 false)
  pcRatio?: string; // PC 端寬高比 (預設 8/3 ~ 1920:720)
  mbRatio?: string; // 幼屏寬高比 (預設 1/1 ~ 800:800)
  class?: string;
}

const {
  pcSrc,
  mbSrc = pcSrc,
  alt,
  title = alt,
  isLcp = true, // 內頁頂部 Hero Banner 預設為 LCP
  pcRatio = "8/3",
  mbRatio = "1/1",
  class: className = "",
} = Astro.props;

const isPcRemote = typeof pcSrc === "string";
const isMbRemote = typeof mbSrc === "string";
---

<section class:list={["w-full overflow-hidden relative", className]}>
  <picture class="block w-full">
    {/* PC 端專用超高清斷點 (>= 768px) */}
    <source
      media="(min-width: 768px)"
      srcset={isPcRemote ? pcSrc : (pcSrc as ImageMetadata).src}
      width={isPcRemote ? 1920 : (pcSrc as ImageMetadata).width}
      height={isPcRemote ? 720 : (pcSrc as ImageMetadata).height}
    />

    {/* 默認移動端圖片 (Astro Image 自動轉為 WebP/AVIF 現代化格式) */}
    {
      isMbRemote ? (
        <img
          src={mbSrc as string}
          alt={alt}
          title={title}
          width={800}
          height={800}
          loading={isLcp ? "eager" : "lazy"}
          fetchpriority={isLcp ? "high" : "low"}
          decoding="async"
          class="banner-img w-full object-cover"
        />
      ) : (
        <Image
          src={mbSrc as ImageMetadata}
          alt={alt}
          title={title}
          width={800}
          height={800}
          format="webp"
          loading={isLcp ? "eager" : "lazy"}
          fetchpriority={isLcp ? "high" : "low"}
          decoding="async"
          class="banner-img w-full object-cover"
        />
      )
    }
  </picture>
  <slot />
</section>

<style lang="scss" define:vars={{ pcRatio, mbRatio }}>
  .banner-img {
    display: block;
    width: 100%;
    aspect-ratio: var(--mbRatio);

    @media (min-width: 768px) {
      aspect-ratio: var(--pcRatio);
    }
  }
</style>
