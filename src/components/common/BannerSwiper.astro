---
/*
 * @Author: 谭洁莹
 * @Date: 2026-05-14 09:49:59
 * @LastEditTime: 2026-05-26 17:26:17
 * @FilePath: /src/components/common/BannerSwiper.astro
 * @Description: 轮播图Banner组件
 */
import { Image } from "astro:assets";
import { useI18n, getLocalizedHref } from "@/i18n/utils";

// 1. 获取多语言状态
const { dict, lang } = useI18n(Astro.url);

// 2. 映射当前语言对应的 API gid
const gidMap: Record<string, string> = {
  "zh-hk": "1", // 繁体中文
  "zh-cn": "2", // 简体中文
  en: "3", // 英文
};
const gid = gidMap[lang] || "1";

// 3. 定义接口地址与域名（用于补全图片绝对路径）
const DOMAIN_URL = "https://admin.hkcmereye.com";
const apiUrl = `${DOMAIN_URL}/api.php/cms/slide/gid/${gid}/num/10`;

// 4. 定义 Banner 数据接口类型
interface BannerItem {
  id: string;
  pic: string; // PC端图片相对路径
  mobilepic: string; // 移动端图片相对路径
  link: string; // 跳转目标链接
  subtitle: string; // 标题/Alt 文案
}

let banners: BannerItem[] = [];
let errorMsg = "";

// 5. 异步获取后台 Banner 数据
try {
  const response = await fetch(apiUrl);
  if (!response.ok) {
    throw new Error(`HTTP error! status: ${response.status}`);
  }
  const resData = await response.json();
  if (resData && resData.code === 1 && Array.isArray(resData.data)) {
    banners = resData.data;
  }
} catch (e) {
  console.error("Fetch Banner Error:", e);
  errorMsg = "Failed to load banners";
}
---

<section class="wrapper banner-carousel-wrapper md:pt-4 lg:pt-7">
  {errorMsg && <div class="text-center py-4 text-red-500">{errorMsg}</div>}

  <div
    id="bannerCarousel"
    class="swiper rounded-xl md:rounded-2xl overflow-hidden aspect-square md:aspect-8/3"
  >
    <div class="swiper-wrapper">
      {
        banners.map((banner, index) => {
          // 补全远程图片绝对路径
          const pcImgUrl = banner.pic.startsWith("http")
            ? banner.pic
            : `${DOMAIN_URL}${banner.pic}`;
          const mbImgUrl = banner.mobilepic.startsWith("http")
            ? banner.mobilepic
            : `${DOMAIN_URL}${banner.mobilepic}`;

          // 使用多语言机制安全处理包裹跳转链接
          const safeHref = getLocalizedHref(banner.link || "#", lang);

          return (
            <div class="swiper-slide h-full">
              {banner.link ? (
                <a
                  href={safeHref}
                  class="block size-full cursor-pointer"
                  title={banner.subtitle}
                >
                  <picture class="block size-full">
                    <source media="(min-width: 768px)" srcset={pcImgUrl} />
                    <Image
                      src={mbImgUrl}
                      alt={banner.subtitle || "Banner Image"}
                      title={banner.subtitle}
                      width={800}
                      height={800}
                      loading={index === 0 ? "eager" : "lazy"}
                      fetchpriority={index === 0 ? "high" : "low"}
                      class="size-full object-cover md:aspect-8/3 rounded-xl md:rounded-2xl"
                    />
                  </picture>
                </a>
              ) : (
                /* 如果后台没有配置链接，则不渲染 a 标签，避免无效点击 */
                <picture class="block size-full">
                  <source media="(min-width: 768px)" srcset={pcImgUrl} />
                  <Image
                    src={mbImgUrl}
                    alt={banner.subtitle || "Banner Image"}
                    title={banner.subtitle}
                    width={800}
                    height={800}
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : "low"}
                    class="size-full object-cover md:aspect-8/3 rounded-xl md:rounded-2xl"
                  />
                </picture>
              )}
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style lang="scss">
  .banner-carousel-wrapper {
    width: 100%;
    overflow: hidden;
    position: relative;

    // 核心 CLS 优化：提前声明响应式宽高比，防止页面产生因图片延迟加载导致的抖动
    picture,
    img {
      display: block;
      width: 100%;
      aspect-ratio: 1/1; // 移动端标准比例
      object-fit: cover;

      @media (min-width: 768px) {
        aspect-ratio: 8/3; // PC端标准比例
      }
    }
  }
</style>

<script>
  import Swiper from "swiper";
  import { Autoplay, Pagination } from "swiper/modules";
  import "swiper/css";
  import "swiper/css/pagination";

  function startBannerCarousel() {
    const el = document.getElementById("bannerCarousel");
    if (!el) return;

    // 健壮性检查：如果旧实例存在，先销毁再初始化（防止 Astro 路由跳转时重复绑定）
    if ((el as any).swiper) {
      (el as any).swiper.destroy(true, true);
    }

    new Swiper("#bannerCarousel", {
      modules: [Autoplay, Pagination],
      loop: true,
      autoplay: {
        delay: 5000,
        disableOnInteraction: false,
      },
      pagination: {
        el: ".swiper-pagination",
        clickable: true,
      },
      slidesPerView: 1,
    });
  }

  // 支持标准首次加载与 Astro 的 view-transitions 路由切换事件
  document.addEventListener("DOMContentLoaded", startBannerCarousel);
  document.addEventListener("astro:page-load", startBannerCarousel);
</script>
