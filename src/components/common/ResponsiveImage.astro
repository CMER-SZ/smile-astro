---
/*
 * @Author: Antigravity AI
 * @Date: 2026-09-01
 * @FilePath: /src/components/common/ResponsiveImage.astro
 * @Description: 通用響應式圖片組件 (防 CLS 佈局坍塌 + 智能 WebP 轉換 + 尺寸適配)
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  title?: string;
  width?: number;
  height?: number;
  aspectRatio?: string; // 自定義寬高比，例如 "16/9", "4/3", "1/1"
  isLcp?: boolean;
  class?: string;
  fit?: "cover" | "contain" | "fill";
}

const {
  src,
  alt,
  title = alt,
  width,
  height,
  aspectRatio,
  isLcp = false,
  class: className = "",
  fit = "cover",
} = Astro.props;

const isRemote = typeof src === "string";
const defaultWidth = width || (isRemote ? 800 : (src as ImageMetadata).width);
const defaultHeight = height || (isRemote ? 600 : (src as ImageMetadata).height);
const calcRatio = aspectRatio || `${defaultWidth} / ${defaultHeight}`;
---

<figure class:list={["overflow-hidden relative m-0 p-0", className]}>
  {
    isRemote ? (
      <img
        src={src as string}
        alt={alt}
        title={title}
        width={defaultWidth}
        height={defaultHeight}
        loading={isLcp ? "eager" : "lazy"}
        fetchpriority={isLcp ? "high" : "low"}
        decoding="async"
        class:list={[
          "w-full h-auto",
          fit === "cover" && "object-cover",
          fit === "contain" && "object-contain",
        ]}
        style={{ aspectRatio: calcRatio }}
      />
    ) : (
      <Image
        src={src as ImageMetadata}
        alt={alt}
        title={title}
        width={defaultWidth}
        height={defaultHeight}
        format="webp"
        loading={isLcp ? "eager" : "lazy"}
        fetchpriority={isLcp ? "high" : "low"}
        decoding="async"
        class:list={[
          "w-full h-auto",
          fit === "cover" && "object-cover",
          fit === "contain" && "object-contain",
        ]}
        style={{ aspectRatio: calcRatio }}
      />
    )
  }
</figure>
