<style lang="scss">
  /* 默認隱藏，大於 1024px 桌面端顯示 */
  .Sidebar {
    display: none;
    align-items: center;
    position: fixed;
    top: 50%;
    right: 0;
    transform: translateY(-45%) translateX(calc(100% - 64px));
    transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1);
    z-index: 99;

    @media screen and (min-width: 1024px) {
      display: flex;
    }

    /* 懸停滑出：1:1 對標原版 */
    &:hover {
      transform: translateY(-50%) translateX(0);
      @media screen and (min-width: 1024px) and (max-width: 1440px) {
        transform: translateY(-50%) translateX(0) scale(0.85);
        transform-origin: right center;
      }
    }

    /* 左側常駐觸發標籤 */
    .sidebar-trigger {
      width: 64px;
      border-radius: 25px 0 0 25px;
      background: #4570b6;
      writing-mode: vertical-rl;
      text-orientation: mixed;
      color: #ffffff;
      text-align: center;
      font-family: var(--font-hk);
      font-size: 20px;
      font-style: normal;
      font-weight: 600;
      line-height: 30px;
      letter-spacing: 4px;
      padding: 22px 20px;
      cursor: pointer;
      user-select: none;
      box-shadow: -3px 0 10px rgba(69, 112, 182, 0.2);
      flex-shrink: 0;
    }

    /* 右側面板 */
    .sidebar-content {
      padding: 30px 18px;
      background: #ffffff;
      border-radius: 0 0 0 25px;
      box-shadow: -4px 4px 15px rgba(69, 112, 182, 0.2);
      display: flex;
      flex-direction: column;
      flex-shrink: 0;

      .sidebar-btn {
        width: 160px;
        height: 140px;
        border-radius: 20px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        text-decoration: none;
        transition: box-shadow 0.25s ease, transform 0.25s ease;

        .sidebar-icon {
          margin-bottom: 14px;
          display: flex;
          justify-content: center;
          align-items: center;
        }

        .sidebar-text {
          text-align: center;
          text-shadow: 0px 0px 2px rgba(0, 0, 0, 0.15);
          font-family: var(--font-hk);
          font-size: 20px;
          font-style: normal;
          font-weight: 700;
          line-height: normal;
          letter-spacing: 4px;
        }
      }

      /* 藍卡：講座 */
      .sidebar-btn-lecture {
        background: #4570b6;
        margin-bottom: 30px;

        .sidebar-text {
          color: #ffffff;
        }

        &:hover {
          box-shadow: 0px 0px 8px 4px rgba(69, 112, 182, 0.5);
          transform: translateY(-2px);
        }
      }

      /* 白卡：術前檢查 */
      .sidebar-btn-check {
        background: #ffffff;
        border: 1px solid #4570b6;

        .sidebar-text {
          color: #4570b6;
        }

        &:hover {
          box-shadow: 0px 0px 8px 4px rgba(0, 0, 0, 0.15);
          transform: translateY(-2px);
        }
      }
    }
  }
</style>
