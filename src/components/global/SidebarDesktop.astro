---
/*
 * @Author: Antigravity AI
 * @Date: 2026-09-01
 * @FilePath: /src/components/global/SidebarDesktop.astro
 * @Description: 桌面端側邊浮動條 (100% 官方原版 Sidebar.vue 1:1 像素級還原 + 雙 SVG + 原始字階)
 */
import { getLangFromUrl, getLocalizedHref, useI18n } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const isCn = lang === "zh-cn";
---

<aside class="Sidebar z-60" aria-label="Desktop Floating Sidebar">
  <!-- 側邊常駐觸發標籤：了 解 更 多 ・ 預 約 -->
  <div class="sidebar-trigger">
    {isCn ? "了 解 更 多 ・ 预 约" : "了 解 更 多 ・ 預 約"}
  </div>

  <!-- 展開面板 -->
  <div class="sidebar-content">
    <!-- 按鈕 1: 講座 -->
    <a
      href={getLocalizedHref("/ophthalmicInfo/AppointForm", lang)}
      target="_blank"
      rel="noopener noreferrer"
      class="sidebar-btn sidebar-btn-lecture"
      data-cta="lecture"
      data-position="desktop_sidebar"
      title={isCn ? "预约希玛眼科矫视讲座" : "預約希瑪眼科矯視講座"}
      aria-label={isCn ? "预约矫视讲座" : "預約矯視講座"}
    >
      <div class="sidebar-icon">
        <img
          src="/images/icons/icon-sidebar-lecture.svg"
          alt=""
          width="59"
          height="44"
          aria-hidden="true"
          loading="lazy"
        />
      </div>
      <div class="sidebar-text">{isCn ? "讲座" : "講座"}</div>
    </a>

    <!-- 按鈕 2: 術前檢查 -->
    <a
      href={getLocalizedHref("/patient-info#beforeJiaoShi", lang)}
      class="sidebar-btn sidebar-btn-check"
      data-cta="patient_info"
      data-position="desktop_sidebar"
      title={isCn ? "查看矫视术前眼睛检查流程" : "查看矯視術前眼睛檢查流程"}
      aria-label={isCn ? "术前眼睛检查" : "術前眼睛檢查"}
    >
      <div class="sidebar-icon">
        <img
          src="/images/icons/icon-sidebar-check.svg"
          alt=""
          width="84"
          height="50"
          aria-hidden="true"
          loading="lazy"
        />
      </div>
      <div class="sidebar-text">{isCn ? "术前检查" : "術前檢查"}</div>
    </a>
  </div>
</aside>

<style lang="scss">
  /* 默認隱藏，大於 1024px 桌面端顯示 */
  .Sidebar {
    display: none;
    align-items: center;
    position: fixed;
    top: 50%;
    right: 0;
    transform: translateY(-45%) translateX(calc(100% - 64px));
    transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1);
    z-index: 99;

    @media screen and (min-width: 1024px) {
      display: flex;
    }

    /* 懸停滑出：1:1 對標原版 */
    &:hover {
      transform: translateY(-50%) translateX(0);
      @media screen and (min-width: 1024px) and (max-width: 1440px) {
        transform: translateY(-50%) translateX(0) scale(0.85);
        transform-origin: right center;
      }
    }

    /* 左側常駐觸發標籤 */
    .sidebar-trigger {
      width: 64px;
      border-radius: 25px 0 0 25px;
      background: #4570b6;
      writing-mode: vertical-rl;
      text-orientation: mixed;
      color: #ffffff;
      text-align: center;
      font-family: var(--font-hk);
      font-size: 20px;
      font-style: normal;
      font-weight: 600;
      line-height: 30px;
      letter-spacing: 4px;
      padding: 22px 20px;
      cursor: pointer;
      user-select: none;
      box-shadow: -3px 0 10px rgba(69, 112, 182, 0.2);
      flex-shrink: 0;
    }

    /* 右側面板 */
    .sidebar-content {
      padding: 30px 18px;
      background: #ffffff;
      border-radius: 0 0 0 25px;
      box-shadow: -4px 4px 15px rgba(69, 112, 182, 0.2);
      display: flex;
      flex-direction: column;
      flex-shrink: 0;

      .sidebar-btn {
        width: 160px;
        height: 140px;
        border-radius: 20px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        text-decoration: none;
        transition: box-shadow 0.25s ease, transform 0.25s ease;

        .sidebar-icon {
          margin-bottom: 14px;
          display: flex;
          justify-content: center;
          align-items: center;
        }

        .sidebar-text {
          text-align: center;
          text-shadow: 0px 0px 2px rgba(0, 0, 0, 0.15);
          font-family: var(--font-hk);
          font-size: 20px;
          font-style: normal;
          font-weight: 700;
          line-height: normal;
          letter-spacing: 4px;
        }
      }

      /* 藍卡：講座 */
      .sidebar-btn-lecture {
        background: #4570b6;
        margin-bottom: 30px;

        .sidebar-text {
          color: #ffffff;
        }

        &:hover {
          box-shadow: 0px 0px 8px 4px rgba(69, 112, 182, 0.5);
          transform: translateY(-2px);
        }
      }

      /* 白卡：術前檢查 */
      .sidebar-btn-check {
        background: #ffffff;
        border: 1px solid #4570b6;

        .sidebar-text {
          color: #4570b6;
        }

        &:hover {
          box-shadow: 0px 0px 8px 4px rgba(0, 0, 0, 0.15);
          transform: translateY(-2px);
        }
      }
    }
  }
</style>
