---
/*
 * @Author: Antigravity AI
 * @Date: 2026-09-02
 * @FilePath: /src/components/global/Header.astro
 * @Description: 全域頂部導航組件 (CSS Flex 自動等高 Logo + 移動端 padding-X 最大 15px + 雙端樣式嚴格物理隔離)
 */
import { useI18n, getLocalizedHref } from "@/i18n/utils";
import { getHeaderNavigation } from "@/config/navigation";

const currentPath = Astro.url.pathname;
const { dict, lang } = useI18n(Astro.url);
const menuList = getHeaderNavigation(dict);

const langList = [
  {
    code: "zh-hk",
    label: "繁體中文",
    href: getLocalizedHref(currentPath, "zh-hk"),
    title: "切換為繁體中文",
  },
  {
    code: "zh-cn",
    label: "简体中文",
    href: getLocalizedHref(currentPath, "zh-cn"),
    title: "切换为简体中文",
  },
];

// 移動端直接切換目標語言
const targetLang = lang === "zh-hk" ? "zh-cn" : "zh-hk";
const targetLangHref = getLocalizedHref(currentPath, targetLang);
const targetLangLabel = lang === "zh-hk" ? "简" : "繁";
const targetLangTitle = lang === "zh-hk" ? "切换为简体中文" : "切換為繁體中文";

---

<header class="header-main" id="site-header">
  <!-- 頂部閱讀滾動進度條 (高度 2px，顏色綁定 --color-primary) -->
  <div class="header-scroll-progress" id="headerScrollProgress" aria-hidden="true"></div>
  <div class="header-container">
    
    <!-- 1. 左側官方 Logo (透過 CSS flex 自適應對齊 header-content 高度，零寫死數值) -->
    <a
      href={getLocalizedHref("/", lang)}
      class="header-logo-link"
      title="返回首頁 - 香港希瑪微笑矯視中心 (CMER Smile)"
      aria-label="香港希瑪微笑矯視中心官方首頁"
    >
      <img
        src="/images/logo.svg"
        alt="香港希瑪微笑矯視中心 (CMER Smile) - SMILE Pro 2.0 / ICL / 激光矯視"
        title="香港希瑪微笑矯視中心官方 Logo"
        class="header-logo-image"
        width="190"
        height="60"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
    </a>

    <!-- 2. 右側複合操作與導航區 (決定整體高度) -->
    <div class="header-content">
      
      <!-- 頂部功能區 (桌面膠囊按鈕 + 雙端語言切換 + 移動端漢堡開關) -->
      <div class="header-top-bar">
        <!-- 綠色膠囊按鈕：Whatsapp 預約 (僅桌面端顯示，移動端隱藏) -->
        <a
          href="https://api.whatsapp.com/send/?phone=85269408569&text=%E6%88%91%E6%83%B3%E9%A0%90%E7%B4%84(W-15)%E7%9F%AF%E8%A6%96%E5%89%8D%E6%AA%A2%E6%9F%A5%E5%8F%8A%E8%AB%AE%E8%A9%A2"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-capsule btn-capsule-whatsapp"
          title="透過 WhatsApp 預約術前檢查 (W-15)"
          aria-label="WhatsApp 預約術前檢查"
          data-cta="whatsapp"
        >
          <img src="/images/icons/icon-whatsapp.svg" alt="WhatsApp 圖標" title="WhatsApp 預約" class="icon-capsule-whatsapp" width="28" height="28" />
          <span>Whatsapp 預約</span>
        </a>

        <!-- 藍色膠囊按鈕：預約講座 (僅桌面端顯示，移動端隱藏) -->
        <a
          href={getLocalizedHref("/ophthalmicInfo/AppointForm", lang)}
          class="btn-capsule btn-capsule-lecture"
          title="登記預約希瑪免費矯視講座"
          aria-label="預約講座"
          data-cta="lecture"
        >
          <img src="/images/icons/icon-lecture.svg" alt="講座預約圖標" title="講座預約" class="icon-capsule-lecture" width="29" height="26" />
          <span>預約講座</span>
        </a>

        <!-- 桌面端語言切換下拉選單 (僅桌面端顯示) -->
        <div class="lang-selector-desktop">
          <button
            type="button"
            class="lang-toggle-btn"
            id="lang-toggle-btn"
            aria-haspopup="true"
            aria-expanded="false"
            aria-label="切換語言"
          >
            <img src="/images/icons/icon-globe.svg" alt="語言選擇圖標" title="切換語言" class="icon-globe" width="21" height="21" />
            <span class="lang-current-label">{lang === "zh-cn" ? "简体中文" : "繁體中文"}</span>
            <img src="/images/icons/icon-chevron.svg" alt="下拉選單箭頭" title="展開語言選單" class="icon-chevron" width="11" height="7" />
          </button>

          <!-- 桌面端語言下拉浮層 -->
          <div class="lang-menu" role="menu">
            <div class="lang-menu-box">
              {
                langList.map((item) => (
                  <a
                    href={item.href}
                    class:list={["lang-item", item.code === lang && "is-active"]}
                    role="menuitem"
                    title={item.title}
                  >
                    {item.label}
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <!-- 移動端直接切換按鈕 (圖標 + 简 / 繁，僅移動端顯示) -->
        <a
          href={targetLangHref}
          class="mobile-lang-link"
          title={targetLangTitle}
          aria-label={targetLangTitle}
        >
          <img src="/images/icons/icon-globe.svg" alt="語言選擇圖標" title={targetLangTitle} class="icon-globe" width="18" height="18" />
          <span class="mobile-lang-text">{targetLangLabel}</span>
        </a>

        <!-- 移動端漢堡開關按鈕 (帶流暢 3 槓變 X 動畫) -->
        <button
          type="button"
          id="nav-toggle-btn"
          class="mobile-toggle-btn"
          aria-controls="main-navbar"
          aria-expanded="false"
          aria-label="開啟全站導航選單"
        >
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </button>
      </div>

      <!-- 3. 單套標準語意主導航 (<nav>)：無重複節點，純 CSS 響應式控制 -->
      <nav id="main-navbar" class="header-nav" aria-label="全站導航">
        <ul class="nav-list">
          {
            menuList.map((item) => (
              <li
                class:list={[
                  "nav-item",
                  `nav-item-${item.id}`,
                  item.children && item.children.length > 0 && "has-children",
                  item.id === "service" && "is-expanded",
                ]}
                data-nav-id={item.id}
              >
                <!-- 一級選單項目 -->
                <div class="nav-item-header">
                  <a
                    href={getLocalizedHref(item.path, lang)}
                    class="nav-link"
                    title={item.title}
                  >
                    <div class="nav-dot-box" aria-hidden="true">
                      {item.hasDot ? (
                        <span class="nav-dot" />
                      ) : (
                        <span class="nav-dot-placeholder" />
                      )}
                    </div>
                    <span class="nav-text">{item.name}</span>
                  </a>

                  {item.children && item.children.length > 0 && (
                    <button
                      type="button"
                      class="nav-expand-btn"
                      aria-label={`切換 ${item.name} 子選單`}
                      aria-expanded={item.id === "service" ? "true" : "false"}
                    >
                      <svg
                        class="icon-nav-expand"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <polyline points="6 9 12 15 18 9" />
                      </svg>
                    </button>
                  )}
                </div>

                <!-- 二級子選單 (桌面為 hover 下拉卡片，移動端支持點擊展開/收起，默認展開矯視服務) -->
                {item.children && item.children.length > 0 && (
                  <div class="subnav-container">
                    <ul class="subnav-list">
                      {item.children.map((child) => (
                        <li class="subnav-item">
                          <a
                            href={getLocalizedHref(child.path, lang)}
                            class="subnav-link"
                            title={child.title}
                          >
                            <span class="subnav-prefix">•</span>
                            <span class="subnav-name">{child.name}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </li>
            ))
          }
        </ul>

        <!-- 移動端抽屜底欄附加功能 (僅移動端抽屜打開時展示) -->
        <div class="mobile-nav-footer">
          <div class="mobile-cta-grid">
            <a
              href="https://api.whatsapp.com/send/?phone=85269408569&text=%E6%88%91%E6%83%B3%E9%A0%90%E7%B4%84(W-15)%E7%9F%AF%E8%A6%96%E5%89%8D%E6%AA%A2%E6%9F%A5%E5%8F%8A%E8%AB%AE%E8%A9%A2"
              target="_blank"
              rel="noopener noreferrer"
              class="mobile-cta-btn mobile-cta-whatsapp"
              data-cta="whatsapp"
            >
              <img src="/images/icons/icon-whatsapp.svg" alt="WhatsApp 圖標" title="WhatsApp 諮詢" class="icon-capsule-whatsapp" width="24" height="24" />
              <span>WhatsApp 諮詢</span>
            </a>
            <a
              href={getLocalizedHref("/ophthalmicInfo/AppointForm", lang)}
              class="mobile-cta-btn mobile-cta-lecture"
              data-cta="lecture"
              title="預約免費矯視講座"
            >
              <img src="/images/icons/icon-lecture.svg" alt="講座預約圖標" title="預約免費講座" class="icon-capsule-lecture" width="24" height="24" />
              <span>預約免費講座</span>
            </a>
          </div>

          <div class="mobile-footer-meta">
            <div class="mobile-social-list">
              <a href="https://www.facebook.com/CMER.SMILE" target="_blank" rel="noopener noreferrer" class="social-icon-link" aria-label="Facebook">
                <img src="/images/icons/icon-fb.svg" alt="Facebook" width="24" height="24" class="social-svg" />
              </a>
              <a href="https://www.instagram.com/cmer_smile" target="_blank" rel="noopener noreferrer" class="social-icon-link" aria-label="Instagram">
                <img src="/images/icons/icon-ig.svg" alt="Instagram" width="24" height="24" class="social-svg" />
              </a>
              <a href="https://www.youtube.com/@cmersmileeyecenter6303" target="_blank" rel="noopener noreferrer" class="social-icon-link" aria-label="YouTube">
                <img src="/images/icons/icon-yt.svg" alt="YouTube" width="24" height="24" class="social-svg" />
              </a>
            </div>
            <a href="tel:+85238925089" class="mobile-phone-link">
              +852 3892 5089
            </a>
          </div>

          <p class="mobile-copyright-text">
            ©2026 香港希瑪微笑矯視中心 (CMER Smile). 
            <a href={getLocalizedHref("/privacy-policy", lang)} class="legal-link">私隱政策</a> | 
            <a href={getLocalizedHref("/disclaimer", lang)} class="legal-link">免責聲明</a>
          </p>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  function initUnifiedHeader() {
    const header = document.getElementById("site-header");
    const toggleBtn = document.getElementById("nav-toggle-btn");
    const navbar = document.getElementById("main-navbar");

    function syncHeaderHeight() {
      if (header) {
        const height = header.getBoundingClientRect().height;
        document.documentElement.style.setProperty("--header-height", `${height}px`);
      }
    }
    syncHeaderHeight();
    window.addEventListener("resize", syncHeaderHeight);

    function toggleMenu() {
      if (!navbar || !toggleBtn) return;
      syncHeaderHeight(); // 打開或關閉前即刻實時同步當前 header 精確高度
      const isOpening = !navbar.classList.contains("is-open");
      if (isOpening) {
        navbar.classList.add("is-open");
        toggleBtn.classList.add("is-active");
        toggleBtn.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
        document.body.style.touchAction = "none";
      } else {
        navbar.classList.remove("is-open");
        toggleBtn.classList.remove("is-active");
        toggleBtn.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
        document.body.style.touchAction = "";
      }
    }

    toggleBtn?.addEventListener("click", toggleMenu);

    // Escape 鍵監聽關閉
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && navbar && navbar.classList.contains("is-open")) {
        toggleMenu();
      }
    });

    // 移動端手風琴子菜單展開/收起交互 (帶自然暗示與無障礙 ARIA 狀態聯動)
    const expandBtns = navbar?.querySelectorAll(".nav-expand-btn");
    expandBtns?.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const navItem = btn.closest(".nav-item");
        if (!navItem) return;

        const isExpanded = navItem.classList.contains("is-expanded");
        if (isExpanded) {
          navItem.classList.remove("is-expanded");
          btn.setAttribute("aria-expanded", "false");
        } else {
          navItem.classList.add("is-expanded");
          btn.setAttribute("aria-expanded", "true");
        }
      });
    });

    // 點擊導航鏈接自動收起移動端選單
    const navLinks = navbar?.querySelectorAll("a");
    navLinks?.forEach((link) => {
      link.addEventListener("click", () => {
        if (window.innerWidth < 1024 && navbar && navbar.classList.contains("is-open")) {
          toggleMenu();
        }
      });
    });

    // 頂部導航滾動進度條與毛玻璃微收縮監聽
    const headerEl = document.getElementById("site-header");
    const progressEl = document.getElementById("headerScrollProgress");
    
    let ticking = false;
    window.addEventListener("scroll", () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollY = window.scrollY;
          const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
          const progress = maxScroll > 0 ? (scrollY / maxScroll) * 100 : 0;

          if (progressEl) {
            progressEl.style.width = `${Math.min(100, Math.max(0, progress))}%`;
          }

          if (headerEl) {
            if (scrollY > 50) {
              headerEl.classList.add("is-compact");
            } else {
              headerEl.classList.remove("is-compact");
            }
          }
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }

  document.addEventListener("DOMContentLoaded", initUnifiedHeader);
  document.addEventListener("astro:page-load", initUnifiedHeader);
</script>

<style lang="scss">
  @reference "@/styles/global.css";
  /* -------------------------------------------------------------------------- */
  /* 全域 Header 現代化 SCSS 封裝 (@apply 模式，0 內聯原子類混亂)               */
  /* -------------------------------------------------------------------------- */

  .header-main {
    @apply sticky top-0 z-50 border-b border-gray-100 transition-all duration-300;
    background-color: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);

    /* 滾動微收縮：收窄容器 padding，且 nav-link padding-block 降為 0 */
    &.is-compact {
      background-color: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      box-shadow: 0 4px 20px rgba(69, 112, 182, 0.08);

      .header-container {
        padding-top: 0.375rem;
        padding-bottom: 0.375rem;
        @media (min-width: 1024px) {
          padding-top: 0.5rem;
          padding-bottom: 0.5rem;
        }
      }

      .header-logo-image {
        @media (min-width: 1024px) {
          height: 70px;
        }
      }

      .nav-link {
        @media (min-width: 1024px) {
          padding-block: 0 !important;
        }
      }
    }
  }

  /* 頂部閱讀進度條：微細 2px，顏色綁定 --color-primary */
  .header-scroll-progress {
    position: absolute;
    top: 0;
    left: 0;
    width: 0%;
    height: 2px;
    background: var(--color-primary, #4570b6);
    z-index: 60;
    transition: width 0.1s linear;
    pointer-events: none;
  }

  /* 容器：1280px 罐頭絕對鎖定 */
  .header-container {
    width: 100% !important;
    max-width: 1280px !important;
    margin-left: auto !important;
    margin-right: auto !important;
    padding-left: 15px !important;
    padding-right: 15px !important;
    box-sizing: border-box !important;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    padding-top: 0.625rem;
    padding-bottom: 0.625rem;
    transition: padding 0.3s ease;
    @media (min-width: 1024px) {
      align-items: center;
      padding-top: 0.875rem;
      padding-bottom: 0.875rem;
    }
  }

  /* Logo 連結欄與實體圖片：首屏物理尺寸精確鎖定，0.001 CLS 偏移根治 */
  .header-logo-link {
    @apply flex items-center shrink-0 pr-4 sm:pr-6 rounded-lg transition-opacity hover:opacity-95;
    &:focus-visible {
      @apply ring-2 ring-primary outline-hidden;
    }
  }

  /* Logo 圖片：明確首屏高度（移動端 42px，桌面端 90px），配合 aspect-ratio 零跳動 */
  .header-logo-image {
    aspect-ratio: 190 / 60;
    height: 42px;
    width: auto;
    object-fit: contain;
    display: block;
    transition: height 0.3s ease;
    @media (min-width: 1024px) {
      height: 90px;
    }
  }

  /* 右側複合內容欄：決定總體導航佈局高度 */
  .header-content {
    @apply flex flex-col justify-between items-end flex-1 pl-2 sm:pl-4;
  }

  /* 頂部操作欄 */
  .header-top-bar {
    @apply flex items-center gap-2.5 sm:gap-4;
  }

  /* 膠囊按鈕規範 (僅桌面端顯示，移動端完全隱藏) */
  .btn-capsule {
    @apply hidden lg:inline-flex items-center gap-2.5 px-5 py-2 rounded-full text-white text-[15px] font-medium tracking-wide shadow-2xs transition-all duration-200 active:scale-95;
    &:hover {
      @apply shadow-xs;
    }
    &:focus-visible {
      @apply ring-2 ring-offset-2 outline-hidden;
    }
  }

  .btn-capsule-whatsapp {
    @apply bg-whatsapp hover:bg-whatsapp-hover;
    animation: whatsapp-ripple 4s ease-in-out infinite;
    &:focus-visible {
      @apply ring-whatsapp;
    }
    .icon-capsule-whatsapp {
      animation: phone-ring 4s cubic-bezier(0.36, 0.07, 0.19, 0.97) infinite;
      transform-origin: center center;
    }
  }

  .btn-capsule-lecture {
    @apply bg-lecture hover:bg-lecture-hover;
    animation: lecture-glow 4s ease-in-out infinite;
    animation-delay: 2s; /* 錯開 2 秒輪替提示，避免兩顆按鈕同時閃爍搶奪注意力 */
    &:focus-visible {
      @apply ring-lecture;
    }
    .icon-capsule-lecture {
      animation: lecture-icon-pulse 4s ease-in-out infinite;
      animation-delay: 2s;
      transform-origin: center center;
    }
  }

  /* WhatsApp 電話搖晃與水波紋暗示 (純 GPU CSS 動畫，0 JS 消耗) */
  @keyframes phone-ring {
    0%, 78%, 100% {
      transform: rotate(0deg) scale(1);
    }
    81% {
      transform: rotate(-14deg) scale(1.08);
    }
    84% {
      transform: rotate(12deg) scale(1.08);
    }
    87% {
      transform: rotate(-10deg) scale(1.05);
    }
    90% {
      transform: rotate(8deg) scale(1.05);
    }
    93% {
      transform: rotate(-4deg) scale(1.02);
    }
    96% {
      transform: rotate(0deg) scale(1);
    }
  }

  @keyframes whatsapp-ripple {
    0%, 78% {
      box-shadow: 0 2px 6px rgba(103, 173, 91, 0.2);
    }
    84% {
      box-shadow: 0 0 0 5px rgba(103, 173, 91, 0.35);
    }
    94%, 100% {
      box-shadow: 0 0 0 10px rgba(103, 173, 91, 0);
    }
  }

  /* 講座預約呼應與高光波紋 */
  @keyframes lecture-glow {
    0%, 78%, 100% {
      box-shadow: 0 2px 6px rgba(45, 106, 183, 0.2);
    }
    86% {
      box-shadow: 0 0 0 5px rgba(69, 112, 182, 0.35);
    }
    96% {
      box-shadow: 0 0 0 10px rgba(69, 112, 182, 0);
    }
  }

  @keyframes lecture-icon-pulse {
    0%, 78%, 100% {
      transform: scale(1);
    }
    84% {
      transform: scale(1.14);
    }
    88% {
      transform: scale(0.94);
    }
    92% {
      transform: scale(1.06);
    }
    96% {
      transform: scale(1);
    }
  }

  .icon-capsule-whatsapp {
    @apply w-[22px] h-[22px] block shrink-0 object-contain;
  }

  .icon-capsule-lecture {
    @apply w-[23px] h-[20px] block shrink-0 object-contain;
  }

  /* 桌面端語言切換選單 (僅桌面端顯示) */
  .lang-selector-desktop {
    @apply hidden lg:block relative py-1;
    &:hover .lang-menu,
    &:focus-within .lang-menu {
      @apply block;
    }
    &:hover .icon-chevron {
      @apply rotate-180;
    }
  }

  .lang-toggle-btn {
