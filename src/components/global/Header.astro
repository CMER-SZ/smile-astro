    @apply flex items-center shrink-0 self-stretch pr-4 sm:pr-6 rounded-lg transition-opacity hover:opacity-95;
    &:focus-visible {
      @apply ring-2 ring-primary outline-hidden;
    }
  }

  /* Logo 圖片：純 CSS 高度自適應填滿父級，自動保持等高，零寫死數值，0 CLS */
  .header-logo-image {
    aspect-ratio: 190 / 60;
    height: 100%;
    max-height: 100%;
    width: auto;
    object-fit: contain;
    display: block;
  }

  /* 右側複合內容欄：決定總體導航佈局高度 */
  .header-content {
    @apply flex flex-col justify-between items-end flex-1 pl-2 sm:pl-4;
  }

  /* 頂部操作欄 */
  .header-top-bar {
    @apply flex items-center gap-2.5 sm:gap-4;
  }

  /* 膠囊按鈕規範 (僅桌面端顯示，移動端完全隱藏) */
  .btn-capsule {
    @apply hidden lg:inline-flex items-center gap-2.5 px-5 py-2 rounded-full text-white text-[15px] font-medium tracking-wide shadow-2xs transition-all duration-200 active:scale-95;
    &:hover {
      @apply shadow-xs;
    }
    &:focus-visible {
      @apply ring-2 ring-offset-2 outline-hidden;
    }
  }

  .btn-capsule-whatsapp {
    @apply bg-whatsapp hover:bg-whatsapp-hover;
    animation: whatsapp-ripple 4s ease-in-out infinite;
    &:focus-visible {
      @apply ring-whatsapp;
    }
    .icon-capsule-whatsapp {
      animation: phone-ring 4s cubic-bezier(0.36, 0.07, 0.19, 0.97) infinite;
      transform-origin: center center;
    }
  }

  .btn-capsule-lecture {
