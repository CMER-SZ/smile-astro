<style lang="scss">
  /* 輔助響應式顯示類 */
  .d-none {
    display: none !important;
  }
  .d-lg-none {
    display: block;
  }
  .d-lg-block {
    display: none;
  }

  /* 移動端樣式 (< 992px) */
  @media screen and (max-width: 991px) {
    .new-Footer-v2 {
      width: 100%;
      background: #f4fafc;
      padding-top: 50px;
      padding-bottom: 90px;

      /* 移除 section 0 10px padding */
      section {
        padding: 0;
      }

      .new-Footer-v2-address {
        max-width: 360px;
        margin: 0 auto;
        border-radius: 14.5px;
        border: 1px solid #4570b6;
        background-color: #fff;
        padding: 30px 20px 24px;
        position: relative;

        &::after {
          background-repeat: no-repeat;
          content: url("https://statichk.cmermedical.com/smile/smileproV2/newFooterV2-bgicon.png");
          position: absolute;
          right: 16px;
          bottom: -10px;
          z-index: 1;
        }

        /* 刪除 max-width */
        .new-Footer-v2-logo {
          display: block;
          margin: 0 auto;
          img {
            width: 100%;
            height: auto;
          }
        }

        .new-Footer-v2-addressTime {
          margin-top: 28px;
          .new-Footer-v2-addressTime-title {
            margin-bottom: 10px;
            color: #4570b6;
            text-align: left;
            font-family: var(--font-hk);
            font-size: 18px;
            font-weight: 600;
            line-height: 1;
            letter-spacing: 3px;
          }
          .new-Footer-v2-addressTime-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            & > div:nth-child(1) {
              color: #4570b6;
              font-family: var(--font-hk);
              font-size: 16px;
              font-weight: 500;
              line-height: 1.8;
            }
            & > div:nth-child(2) {
              width: 96px;
              text-align: left;
              color: #6d6e71;
              font-family: var(--font-number);
              font-size: 16px;
              font-weight: 500;
              line-height: 1.8;
            }
