---
/*
 * @Author: Antigravity AI
 * @Date: 2026-09-03
 * @FilePath: /src/components/global/Footer.astro
 * @Description: 1:1 像素級還原線上官方標準 new-Footer-v2 (浮動白卡、門市地址、營業時間、吉祥物、雙欄導航與社群連結)
 */
import { useI18n, getLocalizedHref } from "@/i18n/utils";

const { lang } = useI18n(Astro.url);
const isCn = lang === "zh-cn";

// 導航鏈接配置 (嚴格遵循 AGENTS.md 路由零 404 與駝峰大小寫規則)
const aboutList = [
  { title: isCn ? "集团及中心简介" : "集團及中心簡介", href: "/group-profile" },
  { title: isCn ? "中心设备" : "中心設備", href: "/medical-equipment" },
];

const serviceList = [
  { title: isCn ? "SMILE Pro 1.0/2.0微笑激光矫视" : "SMILE Pro 1.0/2.0微笑激光矯視", href: "/smilePro" },
  { title: isCn ? "ICL植入式隐形眼镜" : "ICL植入式隱形眼鏡", href: "/vision-correction-icl" },
  { title: isCn ? "SMILE 微笑激光矫视" : "SMILE 微笑激光矯視", href: "/vision-correction/relex-smile" },
  { title: isCn ? "老花矫视" : "老花矯視", href: "/vision-correction-presbyopia" },
  { title: isCn ? "LASIK 激光矫视" : "LASIK 激光矯視", href: "/vision-correction-lasik" },
];

const diagnosisList = [
  { title: isCn ? "眼睛检查及矫视前" : "眼睛檢查及矯視前", href: "/patient-info#beforeJiaoShi" },
  { title: isCn ? "矫视后覆诊" : "矯視後覆診", href: "/patient-info#afterJiaoShi" },
  { title: isCn ? "矫视流程" : "矯視流程", href: "/patient-info#inJiaoShi" },
];

const newsList = [
  { title: isCn ? "科普知识" : "科普知識", href: "/blog" },
  { title: isCn ? "个案分享" : "個案分享", href: "/video" },
];
---

<footer class="new-Footer-v2" id="site-footer" aria-label={isCn ? "网站页脚与门市资讯" : "網站頁尾與門市資訊"}>
  <div class="container">
    <section>
      <!-- 左側白色浮動卡片 (含 Logo、營業時間、中環/旺角門市、吉祥物形象) -->
      <div class="new-Footer-v2-address">
        <a class="new-Footer-v2-logo" href={getLocalizedHref("/", lang)} title="香港希瑪微笑矯視中心官方首頁" aria-label="香港希瑪微笑矯視中心官方首頁">
          <img
            src="https://statichk.cmermedical.com/smile/smileproV2/Smile-footer-mobile-LogoV2.svg"
            alt="香港希瑪微笑矯視中心 (CMER SMILE Refractive Center)"
            title="香港希瑪微笑矯視中心 (CMER SMILE Refractive Center)"
            width="492"
            height="104"
            loading="lazy"
            decoding="async"
          />
        </a>

        <!-- 營業時間 -->
        <div class="new-Footer-v2-addressTime">
          <h2 class="new-Footer-v2-addressTime-title">
            {isCn ? "营业时间" : "營業時間"}
          </h2>
          <div class="new-Footer-v2-addressTime-item">
            <div>{isCn ? "星期一至五" : "星期一至五"}</div>
            <div>9:00-19:00</div>
          </div>
          <div class="new-Footer-v2-addressTime-item">
            <div>{isCn ? "星期六" : "星期六"}</div>
            <div>9:00-18:00</div>
          </div>
          <div class="new-Footer-v2-addressTime-item">
            <div>{isCn ? "星期日及公众假期" : "星期日及公眾假期"}</div>
            <div>{isCn ? "休息" : "休息"}</div>
          </div>
        </div>

        <!-- 門市地址列表 (增強 Local SEO 語意標記) -->
        <address class="new-Footer-v2-loction not-italic">
          <div class="new-Footer-v2-loction-item">
            <div>
              <strong>{isCn ? "中环" : "中環"}</strong>
              <a
                href="https://maps.google.com/?q=Central+Building+Pedder+Street"
                target="_blank"
                rel="noopener noreferrer"
                title={isCn ? "在 Google 地图查看中环诊所" : "在 Google 地圖查看中環診所"}
                aria-label="Google 地圖查看中環門市"
              >
                <img
                  src="https://statichk.cmermedical.com/smile/new-footerV2-address-pc.avif"
                  alt={isCn ? "香港中环中建大厦门市地图导航" : "香港中環中建大廈門市地圖導航"}
                  title={isCn ? "Google 地图查看中环门市" : "Google 地圖查看中環門市"}
                  width="58"
                  height="52"
                  loading="lazy"
                />
              </a>
            </div>
            <p>
              {isCn ? "毕打街1-3号中建大厦1512室" : "畢打街1-3號中建大廈1512室"}<br />
              {isCn ? "(港铁站G出口，置地广场楼上)" : "(港鐵站G出口，置地廣場樓上)"}
            </p>
          </div>

          <div class="new-Footer-v2-loction-item">
            <div>
              <strong>{isCn ? "旺角" : "旺角"}</strong>
              <a
                href="https://maps.google.com/?q=Grand+Century+Place+Mong+Kok"
                target="_blank"
                rel="noopener noreferrer"
                title={isCn ? "在 Google 地图查看旺角诊所" : "在 Google 地圖查看旺角診所"}
                aria-label="Google 地圖查看旺角門市"
              >
                <img
                  src="https://statichk.cmermedical.com/smile/new-footerV2-address-pc.avif"
                  alt={isCn ? "香港旺角雅兰中心门市地图导航" : "香港旺角雅蘭中心門市地圖導航"}
                  title={isCn ? "Google 地图查看旺角门市" : "Google 地圖查看旺角門市"}
                  width="58"
                  height="52"
                  loading="lazy"
                />
              </a>
            </div>
            <p>
              {isCn ? "弥敦道625及639号雅兰中心一期" : "彌敦道625及639號雅蘭中心一期"}<br />
              {isCn ? "1725B室 (港铁站E1出口)" : "1725B室 (港鐵站E1出口)"}
            </p>
          </div>
        </address>
      </div>

      <!-- 右側全域導航選單 (雙欄藍點佈局) -->
      <nav class="new-Footer-v2-menu" aria-label={isCn ? "全站导航链接" : "全站導航鏈接"}>
        <!-- 選單欄 1 -->
        <div class="new-Footer-v2-menu-left">
          <!-- 關於希瑪 -->
          <div class="new-Footer-v2-menu-left-item">
            <span class="new-Footer-v2-menu-item-title">{isCn ? "关于希玛" : "關於希瑪"}</span>
            <ul>
              {
                aboutList.map((item) => (
                  <li>
                    <a class="new-Footer-v2-menu-item-link" href={getLocalizedHref(item.href, lang)}>
                      {item.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- 矯視服務 -->
          <div class="new-Footer-v2-menu-left-item services">
            <span class="new-Footer-v2-menu-item-title">{isCn ? "矫视服务" : "矯視服務"}</span>
            <ul>
              {
                serviceList.map((item) => (
                  <li>
                    <a class="new-Footer-v2-menu-item-link" href={getLocalizedHref(item.href, lang)}>
                      {item.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- 診症須知 -->
          <div class="new-Footer-v2-menu-left-item">
            <a class="new-Footer-v2-menu-item-title" href={getLocalizedHref("/patient-info", lang)}>
              {isCn ? "诊症须知" : "診症須知"}
            </a>
            <ul>
              {
                diagnosisList.map((item) => (
                  <li>
                    <a class="new-Footer-v2-menu-item-link" href={getLocalizedHref(item.href, lang)}>
                      {item.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <!-- 選單欄 2 -->
        <div class="new-Footer-v2-menu-right">
          <!-- 收費詳情 -->
          <div class="new-Footer-v2-menu-left-item">
            <a class="new-Footer-v2-menu-item-title" href={getLocalizedHref("/fee", lang)}>
              {isCn ? "收费详情" : "收費詳情"}
            </a>
          </div>

          <!-- 醫生介紹 -->
          <div class="new-Footer-v2-menu-left-item">
            <a class="new-Footer-v2-menu-item-title" href={getLocalizedHref("/our-medical-team", lang)}>
              {isCn ? "医生介绍" : "醫生介紹"}
            </a>
          </div>

          <!-- 常見問題 -->
          <div class="new-Footer-v2-menu-left-item">
            <a class="new-Footer-v2-menu-item-title" href={getLocalizedHref("/FreQuestions", lang)}>
              {isCn ? "常见问题" : "常見問題"}
            </a>
          </div>

          <!-- 矯視資訊 -->
          <div class="new-Footer-v2-menu-left-item">
            <span class="new-Footer-v2-menu-item-title">{isCn ? "矫视资讯" : "矯視資訊"}</span>
            <ul>
              {
                newsList.map((item) => (
                  <li>
                    <a class="new-Footer-v2-menu-item-link" href={getLocalizedHref(item.href, lang)}>
                      {item.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- 聯絡我們 -->
          <div class="new-Footer-v2-menu-left-item">
            <a class="new-Footer-v2-menu-item-title" href={getLocalizedHref("/contact-us", lang)}>
              {isCn ? "联络我们" : "聯絡我們"}
            </a>
          </div>

          <!-- 社交媒體官方入口 -->
          <div class="new-Footer-v2-menu-right-url">
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://www.facebook.com/CMER.SMILE"
              title="Facebook 官方專頁"
              aria-label="Facebook 官方專頁"
            >
              <img
                src="/images/icons/icon-fb.svg"
                alt="Facebook 官方專頁"
                width="26"
                height="27"
                loading="lazy"
              />
            </a>
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://www.instagram.com/cmer_smile/?hl=en"
              title="Instagram 官方專頁"
              aria-label="Instagram 官方專頁"
            >
              <img
                src="/images/icons/icon-ig.svg"
                alt="Instagram 官方專頁"
                width="27"
                height="27"
                loading="lazy"
              />
            </a>
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://www.youtube.com/channel/UCkYbtBhKYc8XyrgG7SAFzRg?view_as=public"
              title="YouTube 官方頻道"
              aria-label="YouTube 官方頻道"
            >
              <img
                src="/images/icons/icon-yt.svg"
                alt="YouTube 官方頻道"
                width="26"
                height="20"
                loading="lazy"
              />
            </a>
          </div>
        </div>
      </nav>
    </section>

    <!-- 單一自適應底部版權與免責聲明 (拒絕桌面/移動端兩套重複代碼) -->
    <div class="footer-bottom m-auto">
      <p class="footer-copyright-links">
        <span>©2026 {isCn ? "香港希玛微笑矫视中心版权所有" : "香港希瑪微笑矯視中心版權所有"}</span>
        <span class="footer-policy-links">
          <a href={getLocalizedHref("/privacy-policy", lang)}>{isCn ? "隐私政策" : "私隱政策"}</a>
          <span class="policy-divider">|</span>
          <a href={getLocalizedHref("/disclaimer", lang)}>{isCn ? "免责条款" : "免責條款"}</a>
        </span>
      </p>
      <p class="footer-disclaimer">
        {isCn 
          ? "本网站资讯仅供参考，不能作诊疗及医疗为依据。" 
          : "本網站資訊僅供參考，不能作診療及醫療為依據。"}
      </p>
    </div>
  </div>
</footer>

<style lang="scss">
  /* 移動端樣式 (< 992px) */
  @media screen and (max-width: 991px) {
    .new-Footer-v2 {
      width: 100%;
      background: #f4fafc;
      padding-top: 50px;
      padding-bottom: 90px;

      /* 移除 section 0 10px padding */
      section {
        padding: 0;
      }

      .new-Footer-v2-address {
        max-width: 360px;
        margin: 0 auto;
        border-radius: 14.5px;
        border: 1px solid #4570b6;
        background-color: #fff;
        padding: 30px 20px 24px;
        position: relative;

        &::after {
          background-repeat: no-repeat;
          content: url("https://statichk.cmermedical.com/smile/smileproV2/newFooterV2-bgicon.png");
          position: absolute;
          right: 16px;
          bottom: -10px;
          z-index: 1;
        }

        /* 刪除 max-width */
        .new-Footer-v2-logo {
          display: block;
          margin: 0 auto;
          img {
            width: 100%;
            height: auto;
          }
        }

        .new-Footer-v2-addressTime {
          margin-top: 28px;
          .new-Footer-v2-addressTime-title {
            margin-bottom: 10px;
            color: #4570b6;
            text-align: left;
            font-family: var(--font-hk);
            font-size: 18px;
            font-weight: 600;
            line-height: 1;
            letter-spacing: 3px;
          }
          .new-Footer-v2-addressTime-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            & > div:nth-child(1) {
              color: #4570b6;
              font-family: var(--font-hk);
              font-size: 16px;
              font-weight: 500;
              line-height: 1.8;
            }
            & > div:nth-child(2) {
              width: 96px;
              text-align: left;
              color: #6d6e71;
              font-family: var(--font-number);
              font-size: 16px;
              font-weight: 500;
              line-height: 1.8;
            }
          }
        }

        .new-Footer-v2-loction {
          position: relative;
          z-index: 2;
          margin-top: 24px;
          .new-Footer-v2-loction-item {
            margin-bottom: 18px;
            & > div {
              display: flex;
              align-items: center;
              gap: 8px;
              strong {
                color: #4570b6;
                font-family: var(--font-hk);
                font-size: 18px;
                font-weight: 700;
              }
              a img {
                width: 24px;
                height: 24px;
              }
            }
            p {
              margin-top: 4px;
              color: #6d6e71;
              font-family: var(--font-hk);
              font-size: 16px;
              font-weight: 400;
              line-height: 1.5;
            }
          }
        }
      }

      .new-Footer-v2-menu {
        display: flex;
        flex-wrap: nowrap;
        justify-content: center;
        gap: 24px;
        margin-top: 36px;

        .new-Footer-v2-menu-left,
        .new-Footer-v2-menu-right {
          display: flex;
          flex-direction: column;
          gap: 16px;

          .new-Footer-v2-menu-left-item {
            position: relative;
            padding-left: 14px;

            &::before {
              content: "";
              position: absolute;
              left: 0;
              top: 7px;
              width: 7px;
              height: 7px;
              background: #4570b6;
              border-radius: 50%;
              flex-shrink: 0;
            }

            .new-Footer-v2-menu-item-title {
              color: #4570b6;
              font-family: var(--font-hk);
              font-size: 16px;
              font-weight: 600;
              text-decoration: none;
              line-height: 1.3;
              display: inline-block;
            }

            ul {
              padding-left: 4px;
              margin-top: 4px;
              list-style: none;
              li {
                margin-top: 4px;
                .new-Footer-v2-menu-item-link {
                  color: #6d6e71;
                  font-family: var(--font-hk);
                  font-size: 16px;
                  font-weight: 400;
                  text-decoration: none;
                  transition: color 0.2s ease;
                  &:hover {
                    color: #4570b6;
                  }
                }
              }
            }
          }
        }

        .new-Footer-v2-menu-right-url {
          display: flex;
          gap: 16px;
          align-items: center;
          margin-top: 8px;
          svg {
            width: 22px;
            height: 22px;
          }
        }
      }

      .footer-bottom {
        text-align: center;
        margin-top: 32px;
        font-family: var(--font-hk);
        font-size: 12px;
        color: #6d6e71;
        line-height: 1.6;

        .footer-disclaimer {
          font-size: 11px;
          color: #595959;
          margin-top: 8px;
          padding: 0 10px;
          line-height: 1.5;
        }

        .footer-copyright-links {
          display: flex;
          flex-direction: column;
          gap: 4px;

          .footer-policy-links {
            display: flex;
            justify-content: center;
            gap: 8px;
            align-items: center;
          }

          a {
            color: #6d6e71;
            text-decoration: none;
            &:hover {
              color: #4570b6;
            }
          }
        }
      }
    }
  }

  /* 桌面端樣式 (>= 992px) */
  @media screen and (min-width: 992px) {
    .new-Footer-v2 {
      width: 100%;
      background: #f4fafc;
      padding-bottom: 24px;
      margin-top: 90px;
      position: relative;

      section {
        display: flex;
        align-items: center;
        gap: clamp(30px, 3.5vw, 65px);
        position: relative;
      }

      /* 左側浮動白卡 */
      .new-Footer-v2-address {
        flex-shrink: 0;
        width: clamp(450px, 38vw, 600px);
        border-radius: 30px;
        border: 1px solid #4570b6;
        background-color: #fff;
        padding: clamp(40px, 3.8vw, 60px) clamp(28px, 3vw, 52px) clamp(50px, 4.5vw, 75px);
        position: relative;
        top: -65px;
        box-shadow: 0 10px 30px rgba(69, 112, 182, 0.08);

        &::after {
          background-repeat: no-repeat;
          content: url("https://statichk.cmermedical.com/smile/newFooterV2-bgicon-pc.avif");
          position: absolute;
          right: clamp(16px, 2.5vw, 50px);
          bottom: -20px;
          z-index: 1;
          pointer-events: none;
        }

        .new-Footer-v2-logo {
          display: block;
          width: 100%;
          max-width: clamp(340px, 30vw, 440px);
          img {
            width: 100%;
            height: auto;
          }
        }

        .new-Footer-v2-addressTime {
          margin-top: clamp(30px, 2.8vw, 45px);
          .new-Footer-v2-addressTime-title {
            margin-bottom: 12px;
            color: #4570b6;
            text-align: left;
            font-family: var(--font-hk);
            font-size: 30px;
            font-weight: 600;
            line-height: 1;
            letter-spacing: 7.5px;
          }
          .new-Footer-v2-addressTime-item {
