              color: #4570b6;
              font-family: var(--font-hk);
              font-size: 19px;
              font-weight: 500;
              line-height: 1.8;
              letter-spacing: 2.28px;
            }
            & > div:nth-child(2) {
              text-align: left;
              color: #6d6e71;
              font-family: var(--font-number);
              font-size: 19px;
              font-weight: 500;
              line-height: 1.8;
              letter-spacing: 2.28px;
            }
          }
        }

        .new-Footer-v2-loction {
          position: relative;
          z-index: 2;
          margin-top: clamp(26px, 2.5vw, 38px);
          .new-Footer-v2-loction-item {
            margin-bottom: clamp(22px, 2vw, 32px);
            & > div {
              display: flex;
              align-items: center;
              gap: 12px;
              strong {
                color: #4570b6;
                font-family: var(--font-hk);
                font-size: 24px;
                font-weight: 800;
                line-height: 1.25;
              }
              a {
                display: inline-block;
                width: 48px;
                height: 44px;
                img {
                  width: 100%;
                  height: auto;
                }
              }
            }
            p {
              margin-top: 10px;
              color: #6d6e71;
              font-family: var(--font-hk);
              font-size: 18px;
              font-weight: 300;
              line-height: 1.66;
            }
          }
        }
      }

      /* 右側導航選單 */
      .new-Footer-v2-menu {
        position: relative;
        padding-top: 25px;
        padding-bottom: 60px;
        display: flex;
        flex-wrap: nowrap;
        justify-content: space-between;
        gap: clamp(30px, 5vw, 40px);
        flex: 1;

        .new-Footer-v2-menu-left {
          flex: 1.15;
        }

        .new-Footer-v2-menu-left,
        .new-Footer-v2-menu-right {
          min-width: 0;
