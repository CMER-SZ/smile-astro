---
import { getLangFromUrl, getLocalizedHref } from "@/i18n/utils";
const lang = getLangFromUrl(Astro.url);
import { useI18n } from "@/i18n/utils";
const { dict } = useI18n(Astro.url);
---

<section class="lg:hidden wrapper mb-7">
  <div class="mb-5 flex items-center justify-center gap-2">
    <img src="/images/icons/icon-slash-l.svg" alt="" width="20" height="19" aria-hidden="true" />
    <p class="text-[24px] font-bold text-center text-primary leading-tight">{dict.common.share.title}</p>
    <img src="/images/icons/icon-slash-r.svg" alt="" width="20" height="19" aria-hidden="true" />
  </div>
  <div class="center gap-3">
    <button
      id="btn-share"
      class="size-14 rounded-full border border-primary center"
      aria-label={dict.common.share.btnShare}
    >
      <img src="/images/icons/icon-share-node.svg" alt="" width="20" height="22" aria-hidden="true" />
    </button>
    <button
      id="btn-copy"
      class="size-14 rounded-full border border-primary center relative"
      aria-label={dict.common.share.btnCopy}
    >
      <img src="/images/icons/icon-link-copy.svg" alt="" width="22" height="22" aria-hidden="true" />
    </button>
  </div>
  <div
    id="toast"
    class="fixed top-4 left-1/2 -translate-x-1/2 z-50 flex items-center gap-2 px-4 py-2.5 rounded border border-[#e1f3d8] bg-[#f0f9eb] text-[#67c23a] shadow-sm transition-all duration-300 transform -translate-y-10 opacity-0 pointer-events-none"
    role="alert"
  >
    <img src="/images/icons/icon-toast-success.svg" alt="" class="size-4" aria-hidden="true" />
    <span class="text-sm font-medium leading-none">{dict.common.share.success}</span>
  </div>
</section>
<script>
  // 封装初始化函数，完美兼容 View Transitions 路由跳转
  function initShareFeatures() {
    const shareBtn = document.getElementById("btn-share");
    const copyBtn = document.getElementById("btn-copy");
    const toast = document.getElementById("toast");

    const pageTitle = document.title;
    const pageUrl = window.location.href;

    // --- 1. 原生分享逻辑 ---
    if (shareBtn) {
      shareBtn.addEventListener("click", async () => {
        // 判断浏览器是否支持 Web Share API
        if (navigator.share) {
          try {
            await navigator.share({
              title: pageTitle,
              text: `推荐给你这个页面：${pageTitle}`,
              url: pageUrl,
            });
          } catch (err) {
            // 用户取消分享或者分享失败，不做特殊处理
            console.log("分享取消或失败:", err);
          }
        } else {
          // 如果系统/浏览器不支持原生分享（如部分 PC 浏览器），降级为“自动复制链接”
          triggerCopy();
        }
      });
    }

    // --- 2. 复制链接逻辑 ---
    if (copyBtn) {
      copyBtn.addEventListener("click", () => {
        triggerCopy();
      });
    }

    // 核心复制与提示函数
    function triggerCopy() {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard
          .writeText(pageUrl)
          .then(() => showToast())
          .catch((err) => {
            console.error("复制失败，使用降级方案", err);
            fallbackCopy(pageUrl);
          });
      } else {
        fallbackCopy(pageUrl);
      }
    }

    // 老旧浏览器降级复制方案
    function fallbackCopy(text: string) {
      const textArea = document.createElement("textarea");
      textArea.value = text;
      // 隐蔽隐藏
      textArea.style.position = "fixed";
      textArea.style.left = "-999999px";
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();
      try {
        document.execCommand("copy");
        showToast();
      } catch (err) {
        alert("复制失败，请手动复制浏览器地址栏链接");
      }
      document.body.removeChild(textArea);
    }

    // 显示“复制成功”小气泡
    function showToast() {
      if (!toast) return;
      toast.classList.remove("opacity-0", "-translate-y-10", "pointer-events-none");
      toast.classList.add("opacity-100", "translate-y-0"); // 向上浮动并淡入

      // 1.5 秒后自动消失
      setTimeout(() => {
        toast.classList.remove("opacity-100", "translate-y-0");
        toast.classList.add("opacity-0", "-translate-y-10", "pointer-events-none");
      }, 1500);
    }
  }

  // 首次加载时执行
  initShareFeatures();
</script>
