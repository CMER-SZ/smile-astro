---
import { ALL_VIDEOS, VIDEO_TABS, type VideoType } from "@/data/videoData";
// 从 URL 获取当前筛选的 tab，默认 smilepro
const currentType = (Astro.url.searchParams.get("type") ||
  "smilepro") as VideoType;
// 根据当前 tab 过滤数据
const displayVideos = ALL_VIDEOS.filter((item) =>
  item.type.includes(currentType),
);
// const displayVideos = currentType
//   ? ALL_VIDEOS.filter((item) => item.type.includes(currentType))
//   : ALL_VIDEOS;

const typeConfig: Record<
  VideoType,
  { bg: string; label: string; color: string }
> = {
  smilepro: { bg: "bg-[#4570B6]", label: "SMILE Pro", color: "#4570B6" },
  smile: { bg: "bg-[#30ABE2]", label: "SMILE", color: "#30ABE2" },
  icl: { bg: "bg-[#EB981A]", label: "ICL", color: "#EB981A" },
};
---

<div class="lg:max-w-7xl mx-auto">
  <div
    class="grid grid-cols-3 text-center text-xl lg:text-3xl font-en font-bold lg:tracking-[0.25em] mb-12 md:mb-20 lg:mb-30"
  >
    {
      VIDEO_TABS.map((tab) => (
        <a
          href={`?type=${tab.key}`}
          class={`py-7 ${currentType === tab.key ? "bg-primary text-white" : "text-primary border-b border-[#4570b64d]"}`}
        >
          {tab.label}
        </a>
      ))
    }
  </div>
  <div
    class="video-list overflow-hidden grid grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-9 w-full lg:w-fit mx-auto"
  >
    {
      displayVideos.map((item) => {
        const primaryType = item.type[0];
        const currentConfig = typeConfig[primaryType];
        return (
          <a
            href={item.link}
            target="_blank"
            rel="noopener noreferrer"
            class="video-item shrink-0 grow-0 aspect-3/5 w-50 lg:w-66 overflow-hidden group"
            draggable="false"
          >
            <img
              src={item.img}
              alt={item.name}
              class="size-full object-cover transition-transform duration-300 group-hover:scale-105"
              loading="lazy"
              draggable="false"
            />
            {currentConfig && (
              <span
                class={`absolute top-3 right-3 lg:top-4 z-10 text-white text-base lg:text-xl px-4 py-1 rounded-full font-en font-bold ${currentConfig.bg}`}
              >
                {currentConfig.label}
              </span>
            )}
            <div class="z-10 absolute bottom-3 left-3 right-3 text-white whitespace-normal">
              <h3
                set:html={item.title}
                class="video-title text-sm lg:text-base font-bold tracking-wider leading-normal mb-1 pb-4 lg:pb-7"
                style={
                  currentConfig ? `--title-color: ${currentConfig.color}` : ""
                }
              />
              <p class="flex flex-wrap items-baseline gap-x-1.5 mt-1">
                {item.name && (
                  <span class="text-sm lg:text-base font-semibold tracking-wider">
                    {item.name}
                  </span>
                )}
                {item.enName && (
                  <span class="text-xs lg:text-sm font-bold tracking-wider">
                    {item.enName}
                  </span>
                )}
              </p>
            </div>
          </a>
        );
      })
    }
  </div>
</div>

<style>
  .video-item {
    position: relative;
    &::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.2));
      pointer-events: none;
    }
  }
  .video-title {
    position: relative;
    &::before {
      content: "";
      position: absolute;
      bottom: 8px;
      left: 0;
      height: 2px;
      width: 52px;
      background: var(--title-color, white);
      @media screen and (min-width: 1024px) {
        bottom: 16px;
        height: 3px;
        width: 68px;
      }
    }
  }
</style>
