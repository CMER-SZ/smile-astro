---
import { Image } from "astro:assets";
import { ALL_VIDEOS, VIDEO_TABS, type VideoType } from "@/data/videoData";
const defaultType = "smilepro";
const typeConfig: Record<
  VideoType,
  { bg: string; label: string; color: string }
> = {
  smilepro: { bg: "bg-[#4570B6]", label: "SMILE Pro", color: "#4570B6" },
  smile: { bg: "bg-[#30ABE2]", label: "SMILE", color: "#30ABE2" },
  icl: { bg: "bg-[#EB981A]", label: "ICL", color: "#EB981A" },
};
---

<div class="lg:max-w-7xl mx-auto">
  <div
    class="grid grid-cols-3 text-center text-xl lg:text-3xl font-en font-bold lg:tracking-[0.25em] mb-12 md:mb-20 lg:mb-30"
    id="video-tabs-container"
  >
    {
      VIDEO_TABS.map((tab) => (
        <button
          data-tab-key={tab.key}
          class={`py-7 transition-colors cursor-pointer ${
            defaultType === tab.key
              ? "bg-primary text-white"
              : "text-primary border-b border-[#4570b64d]"
          }`}
        >
          {tab.label}
        </button>
      ))
    }
  </div>

  <div
    class="video-list overflow-hidden grid grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-9 w-full lg:w-fit mx-auto"
  >
    {
      ALL_VIDEOS.map((item) => {
        const hasDefault = item.type.includes(defaultType);
        const cardDisplayType = hasDefault ? defaultType : item.type[0];
        const currentConfig = typeConfig[cardDisplayType];
        return (
          <div
            class="video-item shrink-0 grow-0 aspect-3/5 w-full lg:w-66 overflow-hidden group"
            data-types={item.type.join(",")}
            style={{ display: hasDefault ? "block" : "none" }}
          >
            <a
              href={item.link}
              target="_blank"
              rel="noopener noreferrer"
              class="block size-full"
            >
              <Image
                src={item.img}
                alt={item.name}
                width={265}
                height={439}
                class="size-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
                draggable="false"
              />
              {currentConfig && (
                <span
                  data-label
                  data-smilepro-bg="bg-[#4570B6]"
                  data-smilepro-text="SMILE Pro"
                  data-smile-bg="bg-[#30ABE2]"
                  data-smile-text="SMILE"
                  data-icl-bg="bg-[#EB981A]"
                  data-icl-text="ICL"
                  class={`absolute top-3 right-3 lg:top-4 z-10 text-white text-base lg:text-xl px-4 py-1 rounded-full font-en font-bold ${currentConfig.bg}`}
                >
                  {currentConfig.label}
                </span>
              )}
              <div class="z-10 absolute bottom-3 left-3 right-3 text-white whitespace-nowarp">
                <h3
                  set:html={item.title}
                  class="video-title text-sm lg:text-base font-bold tracking-wider leading-normal mb-1 pb-4 lg:pb-7"
                  style={
                    currentConfig ? `--title-color: ${currentConfig.color}` : ""
                  }
                />
                <p class="flex flex-wrap items-baseline gap-x-1.5 mt-1">
                  {item.name && (
                    <span class="text-sm lg:text-base font-semibold tracking-wider">
                      {item.name}
                    </span>
                  )}
                  {item.enName && (
                    <span class="text-xs lg:text-sm font-bold tracking-wider">
                      {item.enName}
                    </span>
                  )}
                </p>
              </div>
            </a>
          </div>
        );
      })
    }
  </div>
</div>
<script>
  function initVideoFilter() {
    const container = document.getElementById("video-tabs-container");
    if (!container) return;

    const tabs = container.querySelectorAll("button");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const currentActiveType = tab.getAttribute("data-tab-key");
        if (!currentActiveType) return;

        // 1. 切换 Tab 激活状态的 class
        tabs.forEach((t) => {
          if (t === tab) {
            t.className =
              "py-7 transition-colors cursor-pointer bg-primary text-white";
          } else {
            t.className =
              "py-7 transition-colors cursor-pointer text-primary border-b border-[#4570b64d]";
          }
        });

        // 2. 执行过滤
        filterVideos(currentActiveType);
      });
    });

    // 过滤核心逻辑（这里把参数名更正为了 activeType）
    function filterVideos(activeType: string) {
      const videoList = document.querySelectorAll(".video-item");
      videoList.forEach((card) => {
        const htmlCard = card as HTMLElement;
        const typesStr = htmlCard.getAttribute("data-types") || "";
        const typesArray = typesStr.split(",");

        if (typesArray.includes(activeType)) {
          htmlCard.style.display = "block";

          const labelEl = htmlCard.querySelector(
            "[data-label]",
          ) as HTMLElement | null;
          const titleEl = htmlCard.querySelector(
            "[data-title]",
          ) as HTMLElement | null;

          if (labelEl) {
            // 完美匹配当前激活的 activeType 属性
            const targetBg = labelEl.getAttribute(`data-${activeType}-bg`);
            const targetText = labelEl.getAttribute(`data-${activeType}-text`);
            const targetColor = labelEl.getAttribute(
              `data-${activeType}-color`,
            );
            if (targetBg && targetText) {
              labelEl.textContent = targetText;
              labelEl.classList.remove(
                "bg-[#4570B6]",
                "bg-[#30ABE2]",
                "bg-[#EB981A]",
              );
              labelEl.classList.add(targetBg);
            }

            // 同步修复样式：让小横线的颜色跟着变
            if (titleEl && targetColor) {
              titleEl.style.setProperty("--title-color", targetColor);
            }
          }
        } else {
          htmlCard.style.display = "none";
        }
      });
    }
  }

  // 确保在 Astro 首屏和启用 ViewTransitions 时都能正常运行
  initVideoFilter();
  document.addEventListener("astro:page-load", initVideoFilter);
</script>
<style>
  .video-item {
    position: relative;
    &::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.2));
      pointer-events: none;
    }
  }
  .video-title {
    position: relative;
    &::before {
      content: "";
      position: absolute;
      bottom: 8px;
      left: 0;
      height: 2px;
      width: 52px;
      background: var(--title-color, white);
      @media screen and (min-width: 1024px) {
        bottom: 16px;
        height: 3px;
        width: 68px;
      }
    }
  }
</style>
