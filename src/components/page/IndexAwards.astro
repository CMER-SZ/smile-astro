---

<div
  class="swiper awards-carousel-wrapper flex-1"
  id="awardsCarousel"
>
  <div class="swiper-wrapper">
    {
      awards.map((award, index) => (
        <div class="swiper-slide awards-carousel-slide">
          <Image
            src={award.img}
            alt={award.alt}
            title={award.title}
            width={132}
            height={132}
            format="webp"
            loading="lazy"
            class="size-full object-cover"
          />
        </div>
      ))
    }
  </div>
</div>
<style lang="scss">
  .awards-carousel-wrapper {
    width: 100%;
    overflow: hidden;
    position: relative;

    img {
      width: 100%;
      aspect-ratio: 1/1;
      object-fit: contain;
    }

    // 2. 强制让 wrapper 具备 Flex 布局，使 slide 排成一排而不会往下平铺堆叠
    :global(.swiper-wrapper) {
      display: flex !important;
      flex-direction: row !important;
      width: 100%;
      height: 100%;
      position: relative;
      transition-timing-function: linear !important;
    }
    :global(.swiper-slide) {
      flex-shrink: 0 !important;
      height: 100% !important;
      position: relative;
    }
  }
</style>
<script>
  import Swiper from "swiper";
  import { Autoplay } from "swiper/modules";
  import "swiper/css";

  function startAwardsCarousel() {
    const el = document.getElementById("awardsCarousel");
    if (!el) return;
    // 健壮性检查：如果该节点身上已经有了旧实例，先清理干净再注册
    if ((el as any).swiper) {
      (el as any).swiper.destroy(true, true);
    }

    new Swiper(el, {
      modules: [Autoplay],
      loop: true,
      speed: 5000,
      autoplay: {
        delay: 0,
        disableOnInteraction: false,
      },
      slidesPerView: 3.2,
      spaceBetween: 28,
      breakpoints: {
        768: {
          slidesPerView: 5,
        },
        1280: {
          slidesPerView: 7,
        },
        1560: {
          slidesPerView: 9,
          spaceBetween: 36,
        },
      },
    });
  }

  // 双事件监听，解决 Astro 首屏载入及多语言切换路由时的“死图”问题
  document.addEventListener("DOMContentLoaded", startAwardsCarousel);
  document.addEventListener("astro:page-load", startAwardsCarousel);
</script>
