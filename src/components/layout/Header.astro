---
/*
 * @Author: 谭洁莹
 * @Date: 2026-04-24 18:42:52
 * @LastEditTime: 2026-05-14 09:43:42
 * @FilePath: /src/components/layout/Header.astro
 * @Description: 公共页头
 */
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import logoImg from "@/assets/images/common/logo.svg";
import logoDarkImg from "@/assets/images/common/logo-dark.svg";
import { useI18n } from "@/i18n/utils";
const currentPath = Astro.url.pathname;
const { dict, lang } = useI18n(Astro.url);
import { getLocalizedHref } from "@/i18n/utils";

const labelMap: Record<string, string> = {
  "zh-hk": "繁體中文",
  "zh-cn": "简体中文",
  // en: "English",
};

const langList = [
  {
    code: "zh-hk",
    label: "繁體",
    labelPC: "繁體中文",
    href: getLocalizedHref(currentPath, "zh-hk"),
  },
  {
    code: "zh-cn",
    label: "简体",
    labelPC: "简体中文",
    href: getLocalizedHref(currentPath, "zh-cn"),
  },
  // {
  //   code: "en",
  //   label: "Eng",
  //   labelPC: "English",
  //   href: getLocalizedHref(currentPath, "en"),
  // },
];

const currentLangLabel = labelMap[lang] || "繁體中文";

interface navItem {
  text: string;
  href: string;
}
interface navGroup {
  title: navItem;
  links?: navItem[];
}
const getHasSubNav = (item: navGroup) => item.links && item.links.length > 0;
const dotClass = "nav-dot-indicator";

const navList = [
  {
    title: { text: dict.common.menu.about.title, href: "" },
    links: [
      { text: dict.common.menu.about.group, href: "/group-profile" },
      { text: dict.common.menu.about.team, href: "/our-medical-team" },
      { text: dict.common.menu.about.equipment, href: "/medical-equipment" },
    ],
  },
  {
    title: { text: dict.common.menu.service.title, href: "" },
    links: [
      { text: dict.common.menu.service.smilepro, href: "/smilePro" },
      { text: dict.common.menu.service.icl, href: "/vision-correction-icl" },
      {
        text: dict.common.menu.service.smile,
        href: "/vision-correction/relex-smile",
      },
      {
        text: dict.common.menu.service.presbyopia,
        href: "/vision-correction-presbyopia",
      },
      {
        text: dict.common.menu.service.lasik,
        href: "/vision-correction-lasik",
      },
    ],
  },
  {
    title: { text: dict.common.menu.instructions.title, href: "/patient-info" },
    links: [
      {
        text: dict.common.menu.instructions.pre,
        href: "/patient-info#beforeJiaoShi",
      },
      {
        text: dict.common.menu.instructions.process,
        href: "/patient-info#inJiaoShi",
      },
      {
        text: dict.common.menu.instructions.post,
        href: "/patient-info#afterJiaoShi",
      },
    ],
  },
  { title: { text: dict.common.menu.fee, href: "/fee" }, links: [] },
  {
    title: { text: dict.common.menu.faq.title, href: "/FreQuestions" },
    links: [],
  },
  {
    title: { text: dict.common.menu.news.title, href: "" },
    links: [
      { text: dict.common.menu.news.case, href: "/video" },
      { text: dict.common.menu.news.knowledge, href: "/blog" },
    ],
  },
  { title: { text: dict.common.menu.contact, href: "/contact-us" }, links: [] },
];
---

<header class="sticky top-0 bg-white z-50">
  <div class="flex wrapper py-4 justify-between items-center relative">
    <a href={getLocalizedHref("/", lang)} class="z-60 relative">
      <Image
        src={logoImg}
        alt="Logo"
        width={329}
        height={104}
        class="logo-light w-39.5 lg:w-82 h-auto transition-all duration-300"
      />
      <Image
        src={logoDarkImg}
        alt="Logo"
        width={174}
        height={51}
        class="logo-dark hidden w-39.5 lg:w-82 h-auto transition-all duration-300"
      />
    </a>
    <div class="flex lg:hidden items-center gap-3 group/menu">
      <details class="relative group/lang">
        <summary class="list-none cursor-pointer p-2 outline-none">
          <Icon
            name="common/language-mini"
            class:list={["size-6 transition-colors", "icon-lang text-primary"]}
          />
        </summary>
        <ul
          class="language-list absolute top-full left-1/2 -translate-x-1/2 bg-white shadow-xl border z-60 min-w-25 text-center rounded-md overflow-hidden border-primary"
        >
          {
            langList.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "block w-full py-3 transition-colors whitespace-nowrap",
                    item.code === lang ? "text-white bg-primary" : "text-desc",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      <details class="group/menu">
        <summary class="list-none cursor-pointer outline-none z-60 relative">
          <div class="size-10 transition-colors">
            <Icon
              name="common/menu-normal"
              class="size-full group-open/menu:hidden"
            />
            <Icon
              name="common/menu-close"
              class="size-full hidden group-open/menu:block"
            />
          </div>
        </summary>
        <nav
          class="fixed inset-x-0 top-18 bottom-0 pb-23 bg-primary z-50 overflow-y-auto px-3 flex flex-col justify-start"
        >
          <ul class="flex flex-col text-white font-medium">
            {
              navList.map((item) => (
                <li>
                  {item.links && item.links.length > 0 ? (
                    <details class="group/sub">
                      <summary class="list-none py-2 flex gap-3 items-center justify-start text-lg tracking-[0.15em] group-open/sub:underline group-open/sub:underline-offset-8">
                        <span class="font-bold">{item.title.text}</span>
                        <Icon
                          name="common/language-arrow"
                          class="w-4 -rotate-90 transition-transform group-open/sub:rotate-0"
                        />
                      </summary>
                      <ul class="mb-2 flex flex-col text-sm text-white tracking-[0.15em] leading-loose">
                        {item.links.map((link) => (
                          <li class="relative pl-3 before:content-[''] before:absolute before:size-1 before:bg-white before:rounded-full before:left-0 before:top-1/2 before:-translate-y-1/2">
                            <a href={getLocalizedHref(link.href, lang)}>
                              {link.text}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </details>
                  ) : (
                    <a
                      href={getLocalizedHref(item.title.href, lang)}
                      class="block py-2 text-lg font-bold tracking-[0.15em]"
                    >
                      {item.title.text}
                    </a>
                  )}
                </li>
              ))
            }
          </ul>
          <div class="pt-10 flex gap-5 items-center">
            <a
              href="https://www.facebook.com/CMER.SMILE"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="social/facebook" class="size-6 text-white" />
            </a>
            <a
              href="https://www.instagram.com/cmer_smile/"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="social/instagram" class="size-6 text-white" />
            </a>
            <a
              href="https://www.youtube.com/channel/UCkYbtBhKYc8XyrgG7SAFzRg"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="social/youtube" class="size-6 text-white" />
            </a>
          </div>
        </nav>
      </details>
    </div>
    <div class="hidden lg:block">
      <div class="flex mb-5 justify-end">
        <div
          class="flex items-center mr-5 gap-4 text-white text-base font-medium"
        >
          <a
            href="https://api.whatsapp.com/send/..."
            class="bg-whatsapp flex items-center px-5 py-2 gap-1.5 rounded-full"
          >
            <Icon name="social/whatsapp" class="size-7" />
            <span>{dict.common.button.btnWhatsapp}</span>
          </a>
          <a
            href="/ophthalmicInfo/AppointForm"
            class="bg-primary flex items-center px-5 py-2 gap-1.5 rounded-full"
          >
            <Icon name="social/lecture" class="size-7" />
            <span>{dict.common.button.btnBook}</span>
          </a>
        </div>
        <div class="text-desc text-sm flex items-center relative group py-2">
          <Icon name="common/language" class="size-5 mr-2" />
          <span class="cursor-pointer mr-1">{currentLangLabel}</span>
          <Icon
            name="common/language-arrow"
            class="w-2.5 transition-transform group-hover:rotate-180"
          />
          <ul
            class="absolute top-full left-1/2 -translate-x-1/2 hidden group-hover:block bg-white shadow-md border border-gray-100 z-60 min-w-30"
          >
            {
              langList.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      "block px-5 py-3",
                      item.code === lang
                        ? "text-primary bg-bg-accent"
                        : "text-desc",
                    ]}
                  >
                    {item.labelPC}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <nav aria-label="Main Navigation">
        <ul class="flex gap-6 text-desc tracking-[0.15em]">
          {
            navList.map((item) => (
              <li class="group pt-3 relative">
                {item.title.href ? (
                  <a
                    href={getLocalizedHref(item.title.href, lang)}
                    class:list={[
                      "hover:text-primary transition-colors",
                      { [dotClass]: getHasSubNav(item) },
                    ]}
                  >
                    {item.title.text}
                  </a>
                ) : (
                  <span
                    class:list={[
                      "cursor-pointer",
                      { [dotClass]: getHasSubNav(item) },
                    ]}
                  >
                    {item.title.text}
                  </span>
                )}
                {item.links.length > 0 && (
                  <ul class="absolute hidden group-hover:block bg-white shadow-lg whitespace-nowrap">
                    {item.links.map((link) => (
                      <li>
                        <a
                          href={getLocalizedHref(link.href, lang)}
                          class="block p-5 hover:bg-primary hover:text-white"
                        >
                          {link.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<style lang="scss">
  @reference "@/styles/global.css";

  summary::-webkit-details-marker {
    display: none;
  }

  // 关键：当移动端菜单 details 展开时
  header:has(details.group\/menu[open]) {
    @apply bg-primary;
    .logo-light {
      display: none;
    }
    .logo-dark {
      display: block;
    }
    .icon-lang {
      color: #fff;
    }
    .language-list {
      border-color: #fff;
    }
  }

  // 内部详情列表点击外部收起
  details[open] > summary::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 55;
    background: transparent;
    pointer-events: none;
  }
</style>
