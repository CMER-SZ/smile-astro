---
import { Image } from "astro:assets";
import logoImg from "@/assets/logo.svg";
import { Icon } from "astro-icon/components";
import { useI18n } from "@/i18n/utils";
const { lang: langParam } = Astro.params;
const currentPath = Astro.url.pathname;
const { dict } = useI18n(Astro.url);
/**
 * 语言切换逻辑： [cite: 20]
 * 1. 如果是简体 (zh-cn)，目标是繁体，链接去掉 /cn，文字显示“繁” [cite: 21, 22]
 * 2. 如果是繁体 (zh-hk)，目标是简体，链接加上 /cn，文字显示“简” [cite: 21, 22]
 */
const isCN = langParam === "cn";
const toggleHref = isCN
  ? currentPath.replace(/^\/cn/, "") || "/"
  : `/cn${currentPath.replace(/\/$/, "")}`;
const toggleLabelMobile = isCN ? "繁" : "简";
const toggleLabelDesktop = isCN ? "简体中文" : "繁體中文";
---

<header class="sticky top-0 bg-white z-50">
  <div class="flex wrapper py-4 justify-between items-center">
    <a href={isCN ? "/cn" : "/"}>
      <Image
        src={logoImg}
        alt="Clinic Logo"
        width={329}
        height={104}
        class="w-39.5 lg:w-82 h-auto"
      />
    </a>
    <div class="flex items-center gap-3 lg:hidden">
      <div class="text-desc text-sm">
        <a href={toggleHref} class="hover:text-primary transition-colors">
          {toggleLabelMobile}
        </a>
      </div>
      <button>
        <Icon name="common/menu-normal" class="size-10 text-white" />
      </button>
    </div>
    <div class="hidden lg:block">
      <div class="flex">
        <div class="flex items-center mr-5 gap-4 text-white text-base font-medium">
          <a href="https://api.whatsapp.com/send/?phone=85269408569&text=%E6%88%91%E6%83%B3%E9%A0%90%E7%B4%84(W-G01)%20%E8%A1%93%E5%89%8D%E6%AA%A2%E6%9F%A5/%E7%9F%AF%E8%A6%96%E8%AC%9B%E5%BA%A7" class="bg-whatsapp flex items-center px-5 py-2 gap-1.5 rounded-full">
            <Icon name="social/whatsapp" class="size-7" />
            <span>{dict.common.button.btnWhatsapp}</span>
          </a>
          <a href="/ophthalmicInfo/AppointForm" class="bg-primary flex items-center px-5 py-2 gap-1.5 rounded-full">
            <Icon name="social/lecture" class="size-7" />
            <span>{dict.common.button.btnBook}</span>
          </a>
        </div>
        <div class="text-desc text-sm flex items-center">
          <Icon name="common/language" class="size-5 mr-2" />
          <a
            href={toggleHref}
            class="hover:text-primary transition-colors mr-3"
          >
            {toggleLabelDesktop}
          </a>
          <Icon name="common/language-arrow" class="w-2.5" />
        </div>
      </div>
    </div>
  </div>
</header>
