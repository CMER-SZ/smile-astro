---
import { getLangFromUrl } from "@/i18n/utils";
import { Image } from "astro:assets";
import logoImg from "@/assets/logo.svg";
import { Icon } from "astro-icon/components";

// 语言逻辑复用原有代码 [cite: 18]
const { lang: langParam } = Astro.params;
const currentPath = Astro.url.pathname;

/**
 * 语言切换逻辑： [cite: 20]
 * 1. 如果是简体 (zh-cn)，目标是繁体，链接去掉 /cn，文字显示“繁” [cite: 21, 22]
 * 2. 如果是繁体 (zh-hk)，目标是简体，链接加上 /cn，文字显示“简” [cite: 21, 22]
 */
const isCN = langParam === "cn";
const toggleHref = isCN
  ? currentPath.replace(/^\/cn/, "") || "/"
  : `/cn${currentPath.replace(/\/$/, "")}`;
const toggleLabelMobile = isCN ? "繁" : "简";
const toggleLabelDesktop = isCN ? "简体中文" : "繁體中文";
---

<header class="sticky top-0 bg-white z-50">
  <div class="flex wrapper py-4 justify-between items-center">
    <a href={isCN ? "/cn" : "/"}>
      <Image
        src={logoImg}
        alt="Clinic Logo"
        width={329}
        height={104}
        class="w-39.5 lg:w-82 h-auto"
      />
    </a>
    <div class="flex items-center gap-3 lg:hidden">
      <div class="text-desc text-sm">
        <a href={toggleHref} class="hover:text-primary transition-colors">
          {toggleLabelMobile}
        </a>
      </div>
      <button>
        <Icon name="common/menu-normal" class="size-10 text-white" />
      </button>
    </div>
    <div class="hidden lg:block">
      <div class="flex">
        <div></div>
        <div class="text-desc text-sm flex items-center">
          <Icon name="common/language" class="size-5 mr-2" />
          <a
            href={toggleHref}
            class="hover:text-primary transition-colors mr-3"
          >
            {toggleLabelDesktop}
          </a>
          <Icon name="common/language-arrow" class="w-2.5" />
        </div>
      </div>
    </div>
  </div>
</header>
