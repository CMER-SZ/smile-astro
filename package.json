{
  "name": "smile-v2",
  "type": "module",
  "version": "0.2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 4001",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:style": "stylelint \"src/**/*.{css,scss,astro,vue}\"",
    "check:lint": "eslint .",
    "check:all": "astro check && eslint . && stylelint \"src/**/*.{css,scss,astro,vue}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:style": "stylelint \"src/**/*.{css,scss,astro,vue}\" --fix",
    "push": "node ./scripts/push.mjs",
    "push:cf": "astro build && wrangler pages deploy dist --project-name 2026smile --branch main --commit-dirty=true",
    "deploy:cf": "astro build && wrangler pages deploy dist --project-name 2026smile --branch main --commit-dirty=true"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vue": "^7.0.2",
    "@fontsource/noto-sans-hk": "^5.2.8",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/poppins": "^5.2.7",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "astro-icon": "^1.1.5",
    "gsap": "^3.15.0",
    "sass": "^1.103.1",
    "sharp": "^0.35.4",
    "swiper": "^14.2.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42"
  },
  "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.12.0",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
